{#
    A form placed in a page, as the module renders it when the theme ships no
    `cms/partials/form.html.twig` of its own.

    The markup is deliberately plain and carries only `cms-*` class names: the
    theme owns the appearance (see `assets/styles/cms-blocks.css` in the CMS
    theme), the module owns the structure and the accessibility.
#}
{% if form %}
    <section class="cms-form" id="{{ form.anchor }}" aria-labelledby="{{ form.anchor }}-title">
        <h2 class="cms-form__title" id="{{ form.anchor }}-title">{{ form.title }}</h2>

        {% if sent %}
            {# `role="status"` rather than an alert: the message is good news,
               and it is announced without interrupting whatever is being read. #}
            <p class="cms-form__sent" role="status">
                {{ success_message }}
            </p>

            {% if lead %}
                {#
                    The conversion a showcase site measures. It carries the code
                    of the form and nothing else — no name, no address, no phone
                    number: whatever tag the site loads reads this queue.

                    Written only when the person agreed to be contacted, and it
                    pushes onto a queue rather than calling anyone: a tag manager
                    that has not been allowed to load simply never reads it.
                #}
                <script>
                    window.dataLayer = window.dataLayer || [];
                    window.dataLayer.push({ event: {{ lead_event|json_encode|raw }}, form_code: {{ form.code|json_encode|raw }} });
                </script>
            {% endif %}
        {% elseif fields is empty %}
            {# Nothing to fill in: an empty form is worse than no form. #}
        {% else %}
            {% if form.description %}
                <p class="cms-form__intro">{{ form.description }}</p>
            {% endif %}

            {% if refused %}
                <p class="cms-form__refused" role="alert">{{ refused }}</p>
            {% elseif errors is not empty %}
                <p class="cms-form__error-summary" role="alert">{{ error_summary }}</p>
            {% endif %}

            {#
                No `novalidate`: the browser catching an empty required field
                before the round trip is a better experience. Everything is
                checked again on the server, which is what actually decides.
            #}
            <form class="cms-form__form" method="post" action="{{ action }}">
                <p class="cms-form__required-hint">{{ required_hint }}</p>

                {% for field in fields %}
                    {% set id = field.inputId(form.code) %}
                    {% set error = errors[field.name]|default(null) %}
                    {% set value = entered[field.name]|default(null) %}
                    {% set described_by = [error ? id ~ '-error' : null, field.help ? id ~ '-help' : null]|filter(v => v)|join(' ') %}

                    <div class="cms-form__field cms-form__field--{{ field.type.value }}{{ error ? ' has-error' : '' }}">
                        {% if field.type.isTickBox() %}
                            <label class="cms-form__tick" for="{{ id }}">
                                {# Never pre-ticked: an agreement given by a
                                   default is not an agreement. #}
                                <input type="checkbox" id="{{ id }}" name="{{ field.name }}" value="1"
                                       {{ field.required ? 'required' : '' }}
                                       {{ value ? 'checked' : '' }}
                                       {% if described_by %}aria-describedby="{{ described_by }}"{% endif %}
                                       {% if error %}aria-invalid="true"{% endif %}>
                                <span class="cms-form__label-text">{{ field.label }}{% if field.required %} <span aria-hidden="true">*</span>{% endif %}</span>
                            </label>
                        {% else %}
                            <label class="cms-form__label" for="{{ id }}">
                                {{ field.label }}{% if field.required %} <span aria-hidden="true">*</span>{% endif %}
                            </label>

                            {% if field.type.value == 'textarea' %}
                                <textarea class="cms-form__input" id="{{ id }}" name="{{ field.name }}" rows="{{ field.rows }}"
                                          {{ field.required ? 'required' : '' }}
                                          {% if field.placeholder %}placeholder="{{ field.placeholder }}"{% endif %}
                                          {% if described_by %}aria-describedby="{{ described_by }}"{% endif %}
                                          {% if error %}aria-invalid="true"{% endif %}>{{ value }}</textarea>
                            {% elseif field.type.value == 'select' %}
                                <select class="cms-form__input" id="{{ id }}" name="{{ field.name }}"
                                        {{ field.required ? 'required' : '' }}
                                        {% if described_by %}aria-describedby="{{ described_by }}"{% endif %}
                                        {% if error %}aria-invalid="true"{% endif %}>
                                    <option value="">{{ choose_label }}</option>
                                    {% for choice in field.choices %}
                                        <option value="{{ choice }}"{{ value == choice ? ' selected' : '' }}>{{ choice }}</option>
                                    {% endfor %}
                                </select>
                            {% elseif field.type.value == 'radio' %}
                                {# A group of radios is one question: without a
                                   fieldset a screen reader reads each button
                                   without the question it answers. #}
                                <fieldset class="cms-form__choices"
                                          {% if described_by %}aria-describedby="{{ described_by }}"{% endif %}>
                                    <legend class="cms-form__legend">{{ field.label }}</legend>
                                    {% for index, choice in field.choices %}
                                        <label class="cms-form__tick" for="{{ id }}-{{ index }}">
                                            <input type="radio" id="{{ id }}-{{ index }}" name="{{ field.name }}" value="{{ choice }}"
                                                   {{ field.required ? 'required' : '' }}
                                                   {{ value == choice ? 'checked' : '' }}>
                                            <span class="cms-form__label-text">{{ choice }}</span>
                                        </label>
                                    {% endfor %}
                                </fieldset>
                            {% else %}
                                {% set input_type = { 'email': 'email', 'phone': 'tel', 'date': 'date' }[field.type.value]|default('text') %}
                                <input class="cms-form__input" type="{{ input_type }}" id="{{ id }}" name="{{ field.name }}"
                                       value="{{ value }}"
                                       {{ field.required ? 'required' : '' }}
                                       {% if field.placeholder %}placeholder="{{ field.placeholder }}"{% endif %}
                                       {% if described_by %}aria-describedby="{{ described_by }}"{% endif %}
                                       {% if error %}aria-invalid="true"{% endif %}>
                            {% endif %}
                        {% endif %}

                        {% if field.help %}
                            <p class="cms-form__help" id="{{ id }}-help">{{ field.help }}</p>
                        {% endif %}

                        {% if error %}
                            <p class="cms-form__error" id="{{ id }}-error">{{ error }}</p>
                        {% endif %}
                    </div>
                {% endfor %}

                {% if form.legalNotice %}
                    <p class="cms-form__legal">
                        {{ form.legalNotice }}
                        {% if form.privacyPolicyUrl %}
                            <a class="cms-form__legal-link" href="{{ form.privacyPolicyUrl }}">{{ privacy_policy_label }}</a>
                        {% endif %}
                    </p>
                {% endif %}

                {#
                    The two checks nobody has to answer: a field only a robot
                    fills in, and the signed moment the form was served. Hidden
                    from assistive technology as well as from sight — an
                    `aria-hidden` input is skipped by a screen reader, which a
                    `display: none` one is too.
                #}
                <div class="cms-form__trap" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">
                    <label for="{{ form.anchor }}-{{ trap_field }}">{{ trap_label }}</label>
                    <input type="text" id="{{ form.anchor }}-{{ trap_field }}" name="{{ trap_field }}" value="" tabindex="-1" autocomplete="off">
                </div>
                <input type="hidden" name="{{ stamp_field }}" value="{{ stamp }}">

                <button class="cms-form__submit" type="submit">{{ submit_label }}</button>
            </form>
        {% endif %}
    </section>
{% endif %}
