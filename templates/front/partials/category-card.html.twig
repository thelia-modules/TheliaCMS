{#
    A category of the catalogue, as the module renders it when the theme ships
    no `cms/partials/category-card.html.twig` of its own: picture, name and a
    link to the category.

    `category` is null when the category is no longer online, and the block
    then renders nothing: the empty placeholder leaves the page.
#}
{% if category %}
    {% set heading_id = 'cms-category-card-' ~ random(100000) %}
    <article class="cms-category-card" aria-labelledby="{{ heading_id }}">
        {% if category.image %}
            <img class="cms-category-card__image" src="{{ category.image }}" alt="" loading="lazy">
        {% endif %}
        <p class="cms-category-card__kicker">{{ labels.kicker }}</p>
        <h3 class="cms-category-card__title" id="{{ heading_id }}">{{ category.title }}</h3>
        <a class="cms-category-card__link" href="{{ category.url }}">{{ labels.discover }}<span class="cms-visually-hidden">: {{ category.title }}</span></a>
    </article>
{% endif %}
