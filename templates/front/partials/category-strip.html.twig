{#
    Several categories in one row, as the module renders them when the theme
    ships no `cms/partials/category-strip.html.twig` of its own: the cards of
    the module side by side, scrolled sideways when the row is wider than the
    page.

    `categories` holds only the categories still online, in the order they
    were picked. The block renders nothing when none is left: the empty
    placeholder leaves the page.
#}
{% if categories is not empty %}
    {% set heading_id = 'cms-category-strip-' ~ random(100000) %}
    <section class="cms-category-strip"{% if heading %} aria-labelledby="{{ heading_id }}"{% endif %}>
        {% if heading %}
            <h2 class="cms-category-strip__heading" id="{{ heading_id }}">{{ heading }}</h2>
        {% endif %}
        <ul class="cms-category-strip__row">
            {% for category in categories %}
                <li class="cms-category-strip__item">
                    {{ include('@TheliaCMSModule/front/partials/category-card.html.twig', { category: category, labels: labels }) }}
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
