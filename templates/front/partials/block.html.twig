{#
    A reusable block, as the module renders it when the theme ships no
    `cms/partials/block.html.twig` of its own.

    The markup was rendered from the document of the block and went through the
    publish pipeline (normaliser, sanitiser, image rewriter) before it was
    stored, so it is printed as it stands. Its look comes from the components
    it is made of and from the stylesheets of the site, never from a stylesheet
    of its own.
#}
{% if html %}
    <div class="cms-block">
        {{ html|raw }}
    </div>
{% endif %}
