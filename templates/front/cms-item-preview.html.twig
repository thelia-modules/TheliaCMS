{#
    The draft of the document of a catalogue item, opened from a signed link:
    the name of the item as the level 1 heading, as the page of the item draws
    it, and the document under it. A theme draws it its own way by shipping
    `cms-item-preview.html.twig` at its root.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ cms_item.title }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block body_class %}cms-item-preview cms-item-preview--{{ cms_item.type.value }}{% endblock %}

{% block body %}
    <header class="cms-page__header">
        <h1 class="cms-page__title">{{ cms_item.title }}</h1>
    </header>

    <article class="cms-page__content cms-page-content">
        {{ cms_item_html|raw }}
    </article>
{% endblock %}
