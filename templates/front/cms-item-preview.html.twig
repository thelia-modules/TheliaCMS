{#
    The draft of the document of a catalogue item alone, opened from a signed
    link: the document in the layout of the theme, without its header, its
    footer or the name of the item, which the page of the item draws. The
    page of the item itself shows the draft from its own link. A theme draws
    this one its own way by shipping `cms-item-preview.html.twig` at its root.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ cms_item.title }}{% endblock %}

{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block body_class %}cms-item-preview cms-item-preview--{{ cms_item.type.value }}{% endblock %}

{% block header %}{% endblock %}

{% block footer %}{% endblock %}

{% block body %}
    <article class="cms-page__content cms-page-content" {{ ai_provenance_attributes(cms_item_provenance) }}>
        {{ cms_item_html|raw }}
    </article>
{% endblock %}
