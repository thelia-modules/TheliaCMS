{#
    The call to action section, as the module renders it when the theme ships
    no `cms/sections/cta.html.twig` of its own.

    Receives `props` (title, text, button_label, button_url), `images`, `uid`,
    `section` and `locale`. The class names are the ones `blocks.css` styles.
#}
<section class="cms-cta" aria-labelledby="cms-cta-title-{{ uid }}">
    <div class="cms-cta__body">
        <h2 class="cms-cta__title" id="cms-cta-title-{{ uid }}">{{ props.title }}</h2>
        {% if props.text is not empty %}
            <p class="cms-cta__text">{{ props.text }}</p>
        {% endif %}
    </div>
    <p class="cms-cta__actions"><a class="cms-button" href="{{ props.button_url }}">{{ props.button_label }}</a></p>
</section>
