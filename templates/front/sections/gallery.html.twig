{#
    The gallery section, as the module renders it when the theme ships no
    `cms/sections/gallery.html.twig` of its own.

    Receives `props` (title, items[image, alt, caption]), `images` (the image of
    each item resolved under `images.items[index].image`, null when the id names
    no image), `uid`, `section` and `locale`.
#}
<section class="cms-gallery" aria-labelledby="cms-gallery-title-{{ uid }}">
    <h2 class="cms-gallery__title" id="cms-gallery-title-{{ uid }}">{{ props.title }}</h2>
    <ul class="cms-gallery__list">
        {% for item in props.items %}
            {% set image = images.items[loop.index0].image|default(null) %}
            <li class="cms-gallery__item">
                <figure>
                    {% if image %}
                        <img src="{{ image.url }}" alt="{{ item.alt }}"{% if image.width %} width="{{ image.width }}"{% endif %}{% if image.height %} height="{{ image.height }}"{% endif %}>
                    {% else %}
                        <img alt="{{ item.alt }}">
                    {% endif %}
                    {% if item.caption is not empty %}
                        <figcaption>{{ item.caption }}</figcaption>
                    {% endif %}
                </figure>
            </li>
        {% endfor %}
    </ul>
</section>
