{#
    The key figures section, as the module renders it when the theme ships no
    `cms/sections/figures.html.twig` of its own.

    Receives `props` (title, items[value, label]), `uid`, `section` and `locale`.
#}
<section class="cms-figures" aria-labelledby="cms-figures-title-{{ uid }}">
    <h2 class="cms-figures__title" id="cms-figures-title-{{ uid }}">{{ props.title }}</h2>
    <ul class="cms-figures__list">
        {% for item in props.items %}
            <li class="cms-figures__item">
                <p class="cms-figures__value">{{ item.value }}</p>
                <p class="cms-figures__label">{{ item.label }}</p>
            </li>
        {% endfor %}
    </ul>
</section>
