{#
    The questions and answers section, as the module renders it when the theme
    ships no `cms/sections/questions.html.twig` of its own.

    Receives `props` (title, items[question, answer]), `uid`, `section` and
    `locale`.
#}
<section class="cms-questions" aria-labelledby="cms-questions-title-{{ uid }}">
    <h2 class="cms-questions__title" id="cms-questions-title-{{ uid }}">{{ props.title }}</h2>
    {% for item in props.items %}
        <details class="cms-questions__item">
            <summary class="cms-questions__question">{{ item.question }}</summary>
            <div class="cms-questions__answer">{{ item.answer|raw }}</div>
        </details>
    {% endfor %}
</section>
