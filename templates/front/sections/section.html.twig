{#
    The titled section, as the module renders it when the theme ships no
    `cms/sections/section.html.twig` of its own.

    Receives `props` (title, text), `images`, `uid`, `section` and `locale`.
    The class names are the ones `blocks.css` styles.
#}
<section class="cms-section" aria-labelledby="cms-section-title-{{ uid }}">
    <h2 class="cms-section__title" id="cms-section-title-{{ uid }}">{{ props.title }}</h2>
    <div class="cms-section__body">{{ props.text|raw }}</div>
</section>
