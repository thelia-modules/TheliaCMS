{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% set is_new = script is null %}

{% block title %}{{ is_new ? 'Add a snippet'|trans({}, 'theliacms') : 'Edit a snippet'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-script-edit{% endblock %}

{% block content %}
    {% form_theme form with bo_form_themes only %}

    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: block('title') } %}
        {% block title %}{{ is_new ? 'Add a snippet'|trans({}, 'theliacms') : script.title }}{% endblock %}

        {% block actions %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.scripts.list') }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to scripts'|trans({}, 'theliacms') }}
            </a>
        {% endblock %}
    {% endembed %}

    {{ form_start(form) }}
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card">
                    <div class="card-header">{{ 'The snippet'|trans({}, 'theliacms') }}</div>
                    <div class="card-body">
                        {{ form_errors(form) }}
                        {{ form_row(form.title) }}
                        {{ form_row(form.content) }}
                        {{ form_row(form.note) }}
                    </div>
                </div>
            </div>

            <div class="col-lg-5 d-flex flex-column gap-3">
                <div class="card">
                    <div class="card-header">{{ 'Where and when'|trans({}, 'theliacms') }}</div>
                    <div class="card-body">
                        {{ form_row(form.placement) }}
                        {{ form_row(form.consentCategory) }}

                        {% if known_vendors is not empty %}
                            <p class="text-muted small">
                                {{ 'Vendors you have already mapped:'|trans({}, 'theliacms') }}
                                {% for vendor in known_vendors %}<code>{{ vendor }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
                            </p>
                        {% endif %}

                        {% if not consent_configured %}
                            <div class="alert alert-warning small mb-0" role="alert">
                                {{ 'No consent platform is set up, so a snippet that waits for consent will never load.'|trans({}, 'theliacms') }}
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">{{ 'Publication'|trans({}, 'theliacms') }}</div>
                    <div class="card-body">
                        {{ form_row(form.active) }}

                        {% if may_write %}
                            <button type="submit" class="btn btn-primary" data-testid="cms-script-submit">{{ 'Save'|trans({}, 'theliacms') }}</button>
                        {% endif %}
                    </div>
                </div>

                {% if not is_new and may_write %}
                    <div class="card border-danger-subtle">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <span class="small text-muted">{{ 'Remove this snippet from the site.'|trans({}, 'theliacms') }}</span>
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    formmethod="post" formaction="{{ path('admin.cms.scripts.delete', { id: script.id }) }}"
                                    formnovalidate
                                    onclick="return confirm('{{ 'Delete this snippet?'|trans({}, 'theliacms')|e('js') }}')">
                                {{ 'Delete'|trans({}, 'theliacms') }}
                            </button>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    {{ form_end(form) }}
{% endblock %}
