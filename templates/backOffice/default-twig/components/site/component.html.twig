{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ component.label }}{% endblock %}
{% block body_testid %}cms-site-component{% endblock %}

{% block scripts_extra %}
    <script src="{{ cms_asset('assets/component-generator.js') }}?v={{ assets_version }}" defer></script>
{% endblock %}

{% block content %}
    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: component.label } %}
        {% block actions %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.components.list') }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to components'|trans({}, 'theliacms') }}
            </a>
        {% endblock %}
    {% endembed %}

    <p class="text-muted">
        <code>Site:{{ component.code }}</code> &middot; {{ component.description }}
        &middot; {% if pages > 0 %}{% include '@TheliaCMSModule/backOffice/default-twig/linked-pages/_trigger.html.twig' with { kind: 'component', key: 'Site:' ~ component.code, count: pages, text: '%count% page(s)'|trans({ '%count%': pages }, 'theliacms'), subject: 'Site:' ~ component.code, testid: 'cms-site-component-pages-open' } only %}{% else %}{{ 'Unused'|trans({}, 'theliacms') }}{% endif %}
        {% if callers is not empty %}&middot; <span data-testid="cms-site-component-callers">{{ 'Drawn by'|trans({}, 'theliacms') }} {% for caller in callers %}<a href="{{ path('admin.cms.components.site.show', { component: caller.code }) }}">{{ caller.label }}</a>{{ not loop.last ? ', ' }}{% endfor %}</span>{% endif %}
        &middot; {% if prototype %}{{ 'Prototype: shown on the pages that hold it, offered to nobody else'|trans({}, 'theliacms') }}{% else %}{{ offered ? 'Offered to the generator'|trans({}, 'theliacms') : 'Not offered to the generator'|trans({}, 'theliacms') }}{% endif %}
    </p>

    {% if prototype and may_make %}
        <div class="alert alert-warning d-flex align-items-center gap-3" data-testid="cms-site-component-prototype">
            <div class="me-auto">
                {{ 'This component is a prototype, offered to nobody yet. Keep it for the whole site to offer it to the generator and on the content screen of every page.'|trans({}, 'theliacms') }}
            </div>
            <form method="post" action="{{ path('admin.cms.components.site.promote', { component: component.code }) }}" data-testid="cms-site-component-promote">
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                <button class="btn btn-sm btn-primary text-nowrap" type="submit">
                    <i class="bi bi-check2-all me-1" aria-hidden="true"></i>{{ 'Keep for the whole site'|trans({}, 'theliacms') }}
                </button>
            </form>
        </div>
    {% endif %}

    <div class="row g-3">
        <div class="col-xl-8">
            {{ include('@TheliaCMSModule/backOffice/default-twig/components/site/_preview.html.twig', { url: preview_url }) }}
        </div>
        <div class="col-xl-4">
            {% if may_ask and cms_ai_available('theliacms.component') %}
                <div class="card mb-3">
                    <div class="card-body">
                        {{ include('@TheliaCMSModule/backOffice/default-twig/components/site/_request_form.html.twig', {
                            testid: 'cms-site-component-change',
                            hidden: { component: component.code },
                            label: 'Ask a change'|trans({}, 'theliacms'),
                            rows: 3,
                            help: 'You see the new version before it replaces this one.'|trans({}, 'theliacms'),
                            button: 'Change it'|trans({}, 'theliacms'),
                        }) }}
                    </div>
                </div>
            {% endif %}
            {% if may_make %}
                {# A copy under a new code, to vary from this one without
                   asking the generator for it from nothing. #}
                <div class="card mb-3">
                    <div class="card-body">
                        <form method="post" action="{{ path('admin.cms.components.site.copy', { component: component.code }) }}" data-testid="cms-site-component-copy">
                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                            <p class="fw-semibold mb-1">{{ 'Copy into a new component'|trans({}, 'theliacms') }}</p>
                            <p class="text-muted small">{{ 'The same template, styles and props, as a prototype: change it, then keep it for the whole site.'|trans({}, 'theliacms') }}</p>
                            <div class="mb-2">
                                <label class="form-label small" for="cms-site-component-copy-code">{{ 'Code'|trans({}, 'theliacms') }}</label>
                                <input class="form-control form-control-sm" id="cms-site-component-copy-code" name="code" required pattern="[A-Z][A-Za-z0-9]{1,39}" maxlength="40" placeholder="{{ component.code }}Dark" aria-describedby="cms-site-component-copy-code-help">
                                <div class="form-text" id="cms-site-component-copy-code-help">{{ 'In PascalCase, such as PriceTableDark. It cannot be changed afterwards.'|trans({}, 'theliacms') }}</div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small" for="cms-site-component-copy-label">{{ 'Label'|trans({}, 'theliacms') }}</label>
                                <input class="form-control form-control-sm" id="cms-site-component-copy-label" name="label" required maxlength="120" value="{{ component.label }}">
                            </div>
                            <button class="btn btn-sm btn-outline-primary" type="submit">
                                <i class="bi bi-copy me-1" aria-hidden="true"></i>{{ 'Copy'|trans({}, 'theliacms') }}
                            </button>
                        </form>
                    </div>
                </div>
                <div class="card mb-3">
                    <div class="card-body">
                        {% if pages > 0 %}
                            <p class="text-muted small mb-0" data-testid="cms-site-component-in-use">{{ 'Used by %count% page(s): it can be deleted once no page holds it.'|trans({ '%count%': pages }, 'theliacms') }}
                                {% include '@TheliaCMSModule/backOffice/default-twig/linked-pages/_trigger.html.twig' with { kind: 'component', key: 'Site:' ~ component.code, count: pages, text: 'See the pages'|trans({}, 'theliacms'), subject: 'Site:' ~ component.code, testid: 'cms-site-component-in-use-open' } only %}</p>
                        {% elseif callers is not empty %}
                            <p class="text-muted small mb-0" data-testid="cms-site-component-drawn">{{ 'Drawn by %count% component(s) of the site: it can be deleted once no component draws it.'|trans({ '%count%': callers|length }, 'theliacms') }}</p>
                        {% else %}
                            <form method="post" action="{{ path('admin.cms.components.site.delete', { component: component.code }) }}" data-testid="cms-site-component-delete"
                                  onsubmit="return confirm('{{ 'Delete this component? It cannot be undone.'|trans({}, 'theliacms')|e('js') }}')">
                                <input type="hidden" name="_token" value="{{ assignToken() }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">
                                    <i class="bi bi-trash me-1" aria-hidden="true"></i>{{ 'Delete the component'|trans({}, 'theliacms') }}
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            <div class="card mb-3">
                <div class="card-header">{{ 'History'|trans({}, 'theliacms') }}</div>
                <ul class="list-group list-group-flush" data-testid="cms-site-component-history">
                    {% for call in history %}
                        <li class="list-group-item small">
                            <a href="{{ path('admin.cms.components.site.candidate', { id: call.logId }) }}">{{ call.createdAt ? call.createdAt|date('Y-m-d H:i') : '' }}</a>
                            <span class="badge text-bg-{{ call.status == 'done' ? 'light' : 'warning' }}">{{ call.status }}</span>
                            <div class="text-muted text-wrap">{{ call.request }}</div>
                        </li>
                    {% else %}
                        <li class="list-group-item small text-muted">{{ 'No call recorded.'|trans({}, 'theliacms') }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
    {{ include('@TheliaCMSModule/backOffice/default-twig/components/site/_definition.html.twig') }}
{% endblock %}
