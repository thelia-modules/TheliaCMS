{#
    The component drawn with its sample on a page of the theme, in a frame
    the editor sets to the width of a phone, a tablet or a screen. The frame
    runs no script: the component draws markup only, and what a model wrote
    is shown in the back office of someone who may do more than it.
#}
{# The whole page or the component alone, as on the content screen: the
   choice is the one that screen stores, and is stored for it in turn. #}
{% set mode_script = "var f = document.querySelector('[data-testid=cms-site-component-frame]'); f.src = this.getAttribute('data-url'); try { localStorage.setItem('theliacms:preview-mode', this.value); } catch (e) {}" %}
<div class="card mb-3">
    <div class="card-header d-flex align-items-center gap-2">
        <span class="me-auto">{{ 'Preview'|trans({}, 'theliacms') }}</span>
        <div class="btn-group btn-group-sm" role="group" aria-label="{{ 'What the preview shows'|trans({}, 'theliacms') }}" data-testid="cms-site-component-preview-modes">
            <input type="radio" class="btn-check" name="cms-component-preview-mode" id="cms-component-preview-mode-page" value="page" data-url="{{ url }}" checked onchange="{{ mode_script }}">
            <label class="btn btn-outline-secondary" for="cms-component-preview-mode-page">{{ 'Whole page'|trans({}, 'theliacms') }}</label>
            <input type="radio" class="btn-check" name="cms-component-preview-mode" id="cms-component-preview-mode-content" value="content" data-url="{{ url ~ '?' ~ constant('TheliaCMS\\Preview\\PreviewLink::CONTENT_ONLY') ~ '=1' }}" onchange="{{ mode_script }}">
            <label class="btn btn-outline-secondary" for="cms-component-preview-mode-content">{{ 'Content only'|trans({}, 'theliacms') }}</label>
        </div>
        <div class="btn-group btn-group-sm" role="group" aria-label="{{ 'Width of the preview'|trans({}, 'theliacms') }}">
            {% for width, name in { '375px': 'Phone', '768px': 'Tablet', '100%': 'Screen' } %}
                <button type="button" class="btn btn-outline-secondary{% if loop.last %} active{% endif %}" aria-pressed="{{ loop.last ? 'true' : 'false' }}"
                        onclick="var f = document.querySelector('[data-testid=cms-site-component-frame]'); f.style.width = '{{ width }}'; this.parentNode.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); }); this.classList.add('active'); this.setAttribute('aria-pressed', 'true');">
                    {{ name|trans({}, 'theliacms') }}
                </button>
            {% endfor %}
        </div>
    </div>
    <div class="card-body p-0 bg-body-tertiary text-center">
        <iframe src="{{ url }}" title="{{ 'Preview of the component'|trans({}, 'theliacms') }}" data-testid="cms-site-component-frame"
                sandbox="allow-same-origin"
                style="width: 100%; height: 42rem; border: 0; background: #fff; display: block; margin: 0 auto;"></iframe>
    </div>
</div>
<script>
    (function () {
        var mode = null;
        try { mode = localStorage.getItem('theliacms:preview-mode'); } catch (e) {}
        var input = mode === 'content' ? document.getElementById('cms-component-preview-mode-content') : null;
        if (input) {
            input.checked = true;
            document.querySelector('[data-testid=cms-site-component-frame]').src = input.getAttribute('data-url');
        }
    })();
</script>
