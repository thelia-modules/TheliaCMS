{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Answers'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-form-submissions{% endblock %}

{% block content %}
    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: block('title') } %}
        {% block title %}
            {{ 'Answers'|trans({}, 'theliacms') }}
            <span class="text-muted fs-6 ms-2">{{ cms_form.title|default(cms_form.code) }}</span>
        {% endblock %}

        {% block actions %}
            {% if total > 0 %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.forms.submissions_export', { id: cms_form.id, format: 'csv', email: email }) }}">
                    <i class="bi bi-filetype-csv me-1" aria-hidden="true"></i> {{ 'Export as CSV'|trans({}, 'theliacms') }}
                </a>
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.forms.submissions_export', { id: cms_form.id, format: 'json', email: email }) }}">
                    <i class="bi bi-filetype-json me-1" aria-hidden="true"></i> {{ 'Export as JSON'|trans({}, 'theliacms') }}
                </a>
            {% endif %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.forms.edit', { id: cms_form.id, edit_language_id: edit_language_id }) }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to the form'|trans({}, 'theliacms') }}
            </a>
        {% endblock %}
    {% endembed %}

    <div class="card mb-3">
        <div class="card-body">
            {# Finding every answer from one person is what answering a request
               to see or to erase their data starts with, so the search is the
               first thing on the screen rather than a filter hidden away. #}
            <form class="row g-2 align-items-end" method="get" action="{{ path('admin.cms.forms.submissions', { id: cms_form.id }) }}">
                <input type="hidden" name="edit_language_id" value="{{ edit_language_id }}">
                <div class="col-md-6">
                    <label class="form-label" for="cms-submissions-email">{{ 'Search by email address'|trans({}, 'theliacms') }}</label>
                    <input class="form-control" type="search" id="cms-submissions-email" name="email" value="{{ email }}"
                           placeholder="{{ 'Part of an address is enough'|trans({}, 'theliacms') }}">
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-primary" type="submit">{{ 'Search'|trans({}, 'theliacms') }}</button>
                    {% if email %}
                        <a class="btn btn-link" href="{{ path('admin.cms.forms.submissions', { id: cms_form.id, edit_language_id: edit_language_id }) }}">
                            {{ 'Clear'|trans({}, 'theliacms') }}
                        </a>
                    {% endif %}
                </div>
                <div class="col-md text-md-end text-muted">
                    {{ '%count% answer(s)'|trans({'%count%': total}, 'theliacms') }}
                </div>
            </form>
        </div>
    </div>

    {% if submissions is empty %}
        <div class="card">
            <div class="card-body text-center py-5 text-muted">
                {% if email %}
                    {{ 'No answer from this address.'|trans({}, 'theliacms') }}
                {% else %}
                    {{ 'No answer yet. They will show up here as visitors send the form.'|trans({}, 'theliacms') }}
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="d-flex flex-column gap-3">
            {% for submission in submissions %}
                <div class="card" data-testid="cms-submission-{{ submission.id }}">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>
                            <strong>{{ submission.created_at }}</strong>
                            {% if submission.email %}
                                <span class="text-muted ms-2">{{ submission.email }}</span>
                            {% endif %}
                            <span class="badge bg-light text-dark border ms-2">{{ submission.locale }}</span>
                        </span>
                        {% if may_delete %}
                            <form method="post" action="{{ path('admin.cms.forms.submissions_delete', { id: cms_form.id, submissionId: submission.id }) }}"
                                  onsubmit="return confirm('{{ 'Delete this answer for good? This is what answering a request to be forgotten does.'|trans({}, 'theliacms')|e('js') }}')">
                                <input type="hidden" name="email" value="{{ email }}">
                                <input type="hidden" name="edit_language_id" value="{{ edit_language_id }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">
                                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i> {{ 'Delete'|trans({}, 'theliacms') }}
                                </button>
                            </form>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            {% for answer in submission.answers %}
                                <dt class="col-sm-4 text-muted fw-normal">{{ answer.label }}</dt>
                                <dd class="col-sm-8">
                                    {% if answer.value is same as(true) %}
                                        {{ yes }}
                                        {% if answer.granted_at is defined %}
                                            {# The moment the agreement was given, which is what has to
                                               be shown if it is ever questioned. #}
                                            <span class="text-muted small">({{ answer.granted_at|date('Y-m-d H:i:s') }})</span>
                                        {% endif %}
                                    {% elseif answer.value is same as(false) %}
                                        {{ no }}
                                    {% elseif answer.value is empty %}
                                        <span class="text-muted">—</span>
                                    {% else %}
                                        {{ answer.value|nl2br }}
                                    {% endif %}
                                </dd>
                            {% endfor %}
                        </dl>
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if pages > 1 %}
            <nav class="mt-3" aria-label="{{ 'Pages of answers'|trans({}, 'theliacms') }}">
                <ul class="pagination mb-0">
                    {% for number in 1..pages %}
                        <li class="page-item {{ number == page ? 'active' : '' }}">
                            <a class="page-link" href="{{ path('admin.cms.forms.submissions', { id: cms_form.id, email: email, page: number, edit_language_id: edit_language_id }) }}"
                               {{ number == page ? 'aria-current="page"' : '' }}>{{ number }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
    {% endif %}

    <p class="text-muted small mt-3 mb-0">
        {% if cms_form.retentionDays > 0 %}
            {{ 'Answers are deleted on their own %days% days after they arrive, as this form says.'|trans({'%days%': cms_form.retentionDays}, 'theliacms') }}
        {% else %}
            {{ 'This form keeps its answers until someone deletes them, which is rarely what a privacy policy says.'|trans({}, 'theliacms') }}
        {% endif %}
    </p>
{% endblock %}
