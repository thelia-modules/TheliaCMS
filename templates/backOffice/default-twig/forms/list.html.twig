{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Forms'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-forms-list{% endblock %}

{% block content %}
    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Forms'|trans({}, 'theliacms') } %}
        {% block actions %}
            {% if may_write %}
                <a class="btn btn-sm btn-primary" href="{{ path('admin.cms.forms.create', { edit_language_id: edit_language_id }) }}">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                    {{ 'New form'|trans({}, 'theliacms') }}
                </a>
            {% endif %}
        {% endblock %}
    {% endembed %}

    {% if forms is empty %}
        <div class="card">
            <div class="card-body text-center py-5">
                <p class="text-muted mb-3">
                    {{ 'No form yet. A form collects what visitors write to you: a contact request, a quote, a callback. You build its fields here, then place it on a page from the editor.'|trans({}, 'theliacms') }}
                </p>
                {% if may_write %}
                    <a class="btn btn-primary" href="{{ path('admin.cms.forms.create', { edit_language_id: edit_language_id }) }}">{{ 'Create the first form'|trans({}, 'theliacms') }}</a>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'Name'|trans({}, 'theliacms') }}</th>
                            <th scope="col">{{ 'Code'|trans({}, 'theliacms') }}</th>
                            <th scope="col">{{ 'Status'|trans({}, 'theliacms') }}</th>
                            <th scope="col">{{ 'Fields'|trans({}, 'theliacms') }}</th>
                            <th scope="col">{{ 'Answers'|trans({}, 'theliacms') }}</th>
                            <th scope="col" class="text-end">{{ 'Actions'|trans({}, 'theliacms') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in forms %}
                            {% set record = row.form %}
                            <tr data-testid="cms-form-row-{{ record.id }}">
                                <td>
                                    <a href="{{ path('admin.cms.forms.edit', { id: record.id, edit_language_id: edit_language_id }) }}">
                                        {{ record.title|default('#' ~ record.id) }}
                                    </a>
                                </td>
                                <td><code>{{ record.code }}</code></td>
                                <td>
                                    {% if record.active == 1 %}
                                        <span class="badge text-bg-success">{{ 'Open'|trans({}, 'theliacms') }}</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">{{ 'Closed'|trans({}, 'theliacms') }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if row.fieldCount > 0 %}
                                        {{ row.fieldCount }}
                                    {% else %}
                                        <span class="text-warning-emphasis">
                                            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                                            {{ 'No field yet'|trans({}, 'theliacms') }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if row.submissionCount > 0 %}
                                        {{ row.submissionCount }}
                                    {% else %}
                                        <span class="text-muted">0</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.forms.edit', { id: record.id, edit_language_id: edit_language_id }) }}">
                                        {{ 'Edit'|trans({}, 'theliacms') }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <p class="text-muted small mt-3 mb-0">
            {{ 'To put a form on a page, open the page editor and drop the Form block where you want it.'|trans({}, 'theliacms') }}
        </p>
    {% endif %}
{% endblock %}
