{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit content'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-page-builder{% endblock %}

{# A megabyte of editor: loaded on this screen and nowhere else. The version
   makes the URL change with the build, so an updated module is not shadowed by
   whatever the browser already holds. #}
{% block head_extra %}
    <link rel="stylesheet" href="{{ module_asset('TheliaCMS', 'assets/page-builder/editor.css') }}?v={{ editor_version }}">
{% endblock %}

{% block scripts_extra %}
    <script src="{{ module_asset('TheliaCMS', 'assets/page-builder/editor.js') }}?v={{ editor_version }}" defer></script>
{% endblock %}

{% block body %}
    <div class="cms-builder">
        {{ form_start(form, { attr: { class: 'cms-builder__form' } }) }}
            <header class="cms-builder__bar">
                <a class="btn btn-sm btn-outline-secondary"
                   href="{{ path('admin.cms.pages.edit', { id: page.id, edit_language_id: edit_language_id }) }}">
                    {{ 'Back to settings'|trans({}, 'theliacms') }}
                </a>

                {# A page can be untranslated in the language being edited. #}
                <p class="cms-builder__title">{{ page.title|default('')|trim ?: 'Untitled page'|trans({}, 'theliacms') }}</p>
                <span class="badge {{ status.badgeClass }}">{{ status.label|trans({}, 'theliacms') }}</span>

                {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}

                <div class="cms-builder__actions">
                    <a class="btn btn-sm btn-outline-secondary" href="{{ draft_preview_url }}" target="_blank" rel="noopener"
                       title="{{ 'Open the draft in a new tab. The link works for 72 hours and can be shared.'|trans({}, 'theliacms') }}"
                       data-testid="cms-page-draft-preview-btn">
                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> {{ 'Preview the draft'|trans({}, 'theliacms') }}
                    </a>
                    {% if preview_url %}
                        <a class="btn btn-sm btn-outline-secondary" href="{{ preview_url }}" target="_blank" rel="noopener"
                           title="{{ 'Preview the page'|trans({}, 'theliacms') }}" data-testid="cms-page-preview-btn">
                            <i class="bi bi-eye" aria-hidden="true"></i> {{ 'Preview'|trans({}, 'theliacms') }}
                        </a>
                    {% endif %}
                    <button type="submit" name="save" value="draft" class="btn btn-sm btn-primary">
                        {{ 'Save draft'|trans({}, 'theliacms') }}
                    </button>
                    <button type="submit" name="save" value="publish" class="btn btn-sm btn-success">
                        {{ 'Publish'|trans({}, 'theliacms') }}
                    </button>
                </div>
            </header>

            {# This screen replaces the whole body block, so the flash messages
               of the layout are rendered here instead — the publication
               warnings are the reason they matter most on this screen. #}
            {{ include('@TheliaCMSModule/backOffice/default-twig/_toasts.html.twig') }}

            {# The editor writes into these three fields; they have to be in the
               DOM before its controller connects. #}
            {{ form_widget(form.projectData) }}
            {{ form_widget(form.html) }}
            {{ form_widget(form.css) }}

            <div class="cms-builder__stage">
                {% component PageBuilder with {
                    form: form,
                    controller: 'cms-page-builder',
                    context: 'cms-page-' ~ page.id,
                    options: builder_options,
                    'data-cms-page-builder-locale-value': builder_locale,
                    'data-cms-page-builder-allow-custom-code-value': allow_custom_code ? 'true' : 'false',
                    'data-cms-page-builder-empty-title-value': 'This page has no content yet'|trans({}, 'theliacms'),
                    'data-cms-page-builder-empty-hint-value': 'Drag a block from the left onto the page to start. Click anything you have placed to change it.'|trans({}, 'theliacms'),
                    'data-cms-page-builder-panel-hint-value': 'Select a block in the page to change its text, its spacing and its colours here.'|trans({}, 'theliacms'),
                    'data-cms-page-builder-partials-value': builder_partials|json_encode,
                    'data-cms-page-builder-content-locale-value': edit_locale,
                    'data-cms-page-builder-partial-category-value': 'Live content'|trans({}, 'theliacms'),
                    'data-cms-page-builder-partial-labels-value': {
                        unknown: 'This block comes from a module this site does not have.'|trans({}, 'theliacms'),
                        failed: 'This block cannot be previewed right now.'|trans({}, 'theliacms'),
                        empty: 'Nothing to show yet.'|trans({}, 'theliacms'),
                    }|json_encode,
                } %}
                    {# Seeded or imported pages have HTML but no editor project:
                       the canvas starts from that markup instead of blank. It
                       went through the sanitizer before being stored. #}
                    {% block content %}{{ initial_html|raw }}{% endblock %}
                {% endcomponent %}
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
