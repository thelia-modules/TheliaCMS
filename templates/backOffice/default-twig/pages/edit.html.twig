{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% set is_new = page.id is null %}

{% block title %}{{ is_new ? 'New page'|trans({}, 'theliacms') : 'Edit page'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-page-edit{% endblock %}

{% block content %}
    {% form_theme form with bo_form_themes only %}

    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: block('title') } %}
        {% block title %}
            {{ parent() }}
            <span class="badge {{ status.badgeClass }}">{{ status.label|trans({}, 'theliacms') }}</span>
            {% if is_home %}<span class="badge bg-primary">{{ 'Home page'|trans({}, 'theliacms') }}</span>{% endif %}
        {% endblock %}

        {% block actions %}
            {% if not is_new %}
                <a class="btn btn-sm btn-primary" href="{{ path('admin.cms.pages.builder', { id: page.id, edit_language_id: edit_language_id }) }}">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i> {{ 'Edit content'|trans({}, 'theliacms') }}
                </a>
            {% endif %}
            {% if preview_url %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ preview_url }}" target="_blank" rel="noopener"
                   title="{{ 'Preview the page'|trans({}, 'theliacms') }}" data-testid="cms-page-preview-btn">
                    <i class="bi bi-eye" aria-hidden="true"></i> {{ 'Preview'|trans({}, 'theliacms') }}
                </a>
            {% endif %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.pages.list', { edit_language_id: edit_language_id }) }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to pages'|trans({}, 'theliacms') }}
            </a>
        {% endblock %}
    {% endembed %}

    <div class="bo-tab-bar">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" data-testid="cms-page-tab-general">
                    {{ 'General'|trans({}, 'theliacms') }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-seo" type="button" data-testid="cms-page-tab-seo">
                    {{ 'Search engines and sharing'|trans({}, 'theliacms') }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-image" type="button" data-testid="cms-page-tab-image">
                    {{ 'Image'|trans({}, 'theliacms') }}
                </button>
            </li>
        </ul>
        {% if not is_new %}
            <div class="bo-tab-bar__aside">
                {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
            </div>
        {% endif %}
    </div>

    {{ form_start(form) }}
        <input type="hidden" name="_token" value="{{ assignToken() }}">
        <div class="tab-content">
            <div class="tab-pane fade show active" id="tab-general" role="tabpanel">
                <div class="row g-3">
                    <div class="col-lg-8">
                        {{ form_row(form.title) }}
                        {{ form_row(form.slug) }}
                        {{ form_row(form.chapo) }}
                        {{ form_row(form.description) }}
                    </div>

                    <div class="col-lg-4">
                        {{ form_row(form.visible) }}
                        {{ form_row(form.parent) }}
                        {{ form_row(form.layout) }}
                        {{ form_row(form.publishAt) }}
                        {{ form_row(form.unpublishAt) }}
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-seo" role="tabpanel">
                <div class="row g-3">
                    <div class="col-lg-8">
                        {{ form_row(form.metaTitle) }}
                        {{ form_row(form.metaDescription) }}
                        {{ form_row(form.ogTitle) }}
                        {{ form_row(form.ogDescription) }}
                        {{ form_row(form.canonical) }}
                    </div>

                    <div class="col-lg-4">
                        {{ form_row(form.twitterCard) }}
                        {{ form_row(form.noindex) }}
                        {{ form_row(form.nofollow) }}
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-image" role="tabpanel">
                {% set current_image = images[page.imageId] ?? null %}
                <div class="row g-3 mb-3">
                    <div class="col-lg-4">
                        <p class="form-label mb-2">{{ 'Current image'|trans({}, 'theliacms') }}</p>
                        {% if current_image %}
                            <div class="card" data-testid="cms-page-current-image">
                                <div class="ratio ratio-4x3 bg-body-secondary rounded-top overflow-hidden">
                                    <img src="{{ current_image.thumbnailUrl }}" alt="" style="object-fit: scale-down">
                                </div>
                                <div class="card-body py-2">
                                    <a class="d-block text-truncate fw-medium text-decoration-none"
                                       href="{{ path('admin.cms.media.edit', { id: current_image.id, edit_language_id: edit_language_id }) }}"
                                       title="{{ current_image.title }}">{{ current_image.title }}</a>
                                    {% if not current_image.isDescribed %}
                                        <span class="badge text-bg-warning">
                                            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                                            {{ 'No alternative text'|trans({}, 'theliacms') }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        {% else %}
                            <p class="text-muted" data-testid="cms-page-current-image">{{ 'This page has no image.'|trans({}, 'theliacms') }}</p>
                        {% endif %}
                    </div>
                    <div class="col-lg-8">
                        {{ form_row(form.imageUpload, { attr: { accept: 'image/jpeg,image/png,image/webp' } }) }}
                    </div>
                </div>

                <fieldset>
                    <legend class="form-label fs-6">{{ 'Choose from the CMS media library'|trans({}, 'theliacms') }}</legend>
                    {{ form_errors(form.image) }}
                    <div class="row row-cols-2 row-cols-md-4 row-cols-xl-6 g-3" data-testid="cms-page-image-choices">
                        {% for choice in form.image %}
                            {% set item = images[choice.vars.value] ?? null %}
                            <div class="col">
                                <div class="card h-100 {{ choice.vars.checked ? 'border-primary' }}">
                                    <label for="{{ choice.vars.id }}" class="ratio ratio-4x3 bg-body-secondary rounded-top overflow-hidden">
                                        {% if item %}
                                            <img src="{{ item.thumbnailUrl }}" alt="" loading="lazy" decoding="async" style="object-fit: scale-down">
                                        {% else %}
                                            <span class="d-flex align-items-center justify-content-center text-muted">
                                                <i class="bi bi-slash-circle fs-2" aria-hidden="true"></i>
                                            </span>
                                        {% endif %}
                                    </label>
                                    <div class="card-body py-2 small">
                                        {{ form_widget(choice, { label: item ? item.title : 'No image'|trans({}, 'theliacms'), translation_domain: false }) }}
                                        {% if item and not item.isDescribed %}
                                            <span class="badge text-bg-warning">{{ 'No alternative text'|trans({}, 'theliacms') }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </fieldset>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-primary">{{ 'Save draft'|trans({}, 'theliacms') }}</button>
        </div>
    {{ form_end(form) }}

    {% if not is_new %}
        {# Kept out of the settings form: each one is a POST of its own. #}
        <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top">
            <form method="post" action="{{ path('admin.cms.pages.publish', { id: page.id, edit_language_id: edit_language_id }) }}">
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                <button type="submit" class="btn btn-sm btn-success">{{ 'Publish this version'|trans({}, 'theliacms') }}</button>
            </form>
            <form method="post" action="{{ path('admin.cms.pages.unpublish', { id: page.id, edit_language_id: edit_language_id }) }}">
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'Unpublish'|trans({}, 'theliacms') }}</button>
            </form>
            <form method="post" action="{{ path('admin.cms.pages.duplicate', { id: page.id, edit_language_id: edit_language_id }) }}">
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'Duplicate'|trans({}, 'theliacms') }}</button>
            </form>
            {% if not is_home %}
                <form method="post" action="{{ path('admin.cms.pages.set_as_home', { id: page.id, edit_language_id: edit_language_id }) }}">
                    <input type="hidden" name="_token" value="{{ assignToken() }}">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'Set as home page'|trans({}, 'theliacms') }}</button>
                </form>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}

{% block scripts_extra %}
    {{ parent() }}
    {{ safe_hook('wysiwyg.js', { location: 'cms-page-edit-js' }) }}
{% endblock %}
