{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% set is_new = page.id is null %}

{% block title %}{{ is_new ? 'New page'|trans({}, 'theliacms') : 'Edit page'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-page-edit{% endblock %}

{% block head_extra %}
    {{ parent() }}
    {# The summary is a few lines: its editor at half the height of the one of
       the description (320 px, the default of the Tiptap module, written on
       the element itself, hence !important). #}
    <style>
        [data-cms-summary] .tiptap-content { min-height: 160px !important; }
    </style>
{% endblock %}

{% block content %}
    {% form_theme form with bo_form_themes only %}

    {# Rendered once, before the tabs: the tab shows only when a module answers. A page not saved has
       no id to attach them to; a model is never published. `fields`: the page holds its robots and
       its canonical URL itself (SEO tab), and prints neither the H1 nor the links of SEOne; its card
       shows the structured data only (SEOne 1.8, which shows every field before). A capture, not a filtered value: it stays
       markup, a filter would hand back a string the escaper would print as text. #}
    {% set seo_module_cards %}{% if not is_new and not is_model %}{{ hook_cards(['cmspage.seo.update-form', 'tab-seo.update-form', 'tab-seo.bottom'], { cmspage_id: page.id, id: page.id, type: 'cmspage', fields: ['json_data'] }) }}{% endif %}{% endset %}
    {# A module sends the editor back with `current_tab=seo` after a save in its card (SEOne, as on the
       catalogue screens): its tab opens again. #}
    {% set seo_modules_open = seo_module_cards|trim is not empty and app.request.query.get('current_tab') == 'seo' %}

    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: block('title') } %}
        {% block title %}
            {{ parent() }}
            <span class="badge {{ status.badgeClass }}">{{ status.label|trans({}, 'theliacms') }}</span>
            {% if is_home %}<span class="badge bg-primary">{{ 'Home page'|trans({}, 'theliacms') }}</span>{% endif %}
            {% if is_model %}<span class="badge text-bg-info" data-testid="cms-page-model-badge">{{ 'Model of the type %type%'|trans({ '%type%': page_type_title }, 'theliacms') }}</span>{% endif %}
        {% endblock %}

        {% block actions %}
            {% if not is_new %}
                <a class="btn btn-sm btn-primary" href="{{ path('admin.cms.pages.content.edit', { id: page.id, edit_language_id: edit_language_id }|merge(return_query)) }}">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i> {{ 'Edit content'|trans({}, 'theliacms') }}
                </a>
            {% endif %}
            {% if preview_url %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ preview_url }}" target="_blank" rel="noopener"
                   title="{{ 'Preview the page'|trans({}, 'theliacms') }}" data-testid="cms-page-preview-btn">
                    <i class="bi bi-eye" aria-hidden="true"></i> {{ 'Preview'|trans({}, 'theliacms') }}
                </a>
            {% endif %}
            {% if not is_new %}
                {# Actions on the whole page, in its header rather than under the
                   tabs, where they read as part of the last one. Kept out of the
                   settings form: each one is a POST of its own. Publication has
                   its place in the bar of the content screen. #}
                {% if not is_model %}
                    <form method="post" action="{{ path('admin.cms.pages.duplicate', { id: page.id, edit_language_id: edit_language_id }|merge(return_query)) }}" class="d-inline" data-testid="cms-page-duplicate">
                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-copy" aria-hidden="true"></i> {{ 'Duplicate'|trans({}, 'theliacms') }}</button>
                    </form>
                {% endif %}
                {% if not is_home and not is_model %}
                    <form method="post" action="{{ path('admin.cms.pages.set_as_home', { id: page.id, edit_language_id: edit_language_id }|merge(return_query)) }}" class="d-inline" data-testid="cms-page-set-as-home">
                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-house" aria-hidden="true"></i> {{ 'Set as home page'|trans({}, 'theliacms') }}</button>
                    </form>
                {% endif %}
                {% if ai_marked %}
                    {# The page keeps the mark of the generator until a person answers for its text. #}
                    <form method="post" action="{{ path('admin.cms.pages.remove_ai_mark', { id: page.id, edit_language_id: edit_language_id }|merge(return_query)) }}" class="d-inline" data-testid="cms-page-remove-ai-mark">
                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="{{ 'A person reviewed the text of this page and answers for it: the page is no longer marked as generated by an AI, in this language.'|trans({}, 'theliacms') }}">{{ 'Remove the AI mark'|trans({}, 'theliacms') }}</button>
                    </form>
                {% endif %}
            {% endif %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ back_url }}" data-testid="cms-page-back-to-list">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to pages'|trans({}, 'theliacms') }}
            </a>
        {% endblock %}
    {% endembed %}

    <div class="bo-tab-bar">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link{{ seo_modules_open ? '' : ' active' }}" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" data-testid="cms-page-tab-general">
                    {{ 'General'|trans({}, 'theliacms') }}
                </button>
            </li>
            {% if has_fields %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-fields" type="button" data-testid="cms-page-tab-fields">
                        {{ 'Fields of %type%'|trans({ '%type%': page_type_title }, 'theliacms') }}
                    </button>
                </li>
            {% endif %}
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-seo" type="button" data-testid="cms-page-tab-seo">
                    {{ 'Search engines and sharing'|trans({}, 'theliacms') }}
                </button>
            </li>
            {% if seo_module_cards|trim is not empty %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link{{ seo_modules_open ? ' active' : '' }}" data-bs-toggle="tab" data-bs-target="#tab-seo-modules" type="button" data-testid="cms-page-tab-seo-modules">
                        {{ 'Search engines (modules)'|trans({}, 'theliacms') }}
                    </button>
                </li>
            {% endif %}
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-image" type="button" data-testid="cms-page-tab-image">
                    {{ 'Image'|trans({}, 'theliacms') }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                {% if is_new %}
                    {# A page not saved has no id to attach files to. #}
                    <span title="{{ 'Save the page first: documents are attached to a saved page.'|trans({}, 'theliacms') }}" data-testid="cms-page-tab-documents-hint">
                        <button class="nav-link disabled" type="button" disabled aria-disabled="true" aria-describedby="tab-documents-unavailable" data-testid="cms-page-tab-documents">
                            {{ 'Documents'|trans({}, 'theliacms') }}
                        </button>
                    </span>
                    <span class="visually-hidden" id="tab-documents-unavailable">{{ 'Save the page first: documents are attached to a saved page.'|trans({}, 'theliacms') }}</span>
                {% else %}
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-documents" type="button" data-testid="cms-page-tab-documents">
                        {{ 'Documents'|trans({}, 'theliacms') }}{% if documents|length > 0 %} <span class="badge text-bg-secondary" data-testid="cms-page-tab-documents-count">{{ documents|length }}</span>{% endif %}
                    </button>
                {% endif %}
            </li>
        </ul>
        {% if not is_new %}
            <div class="bo-tab-bar__aside">
                {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
            </div>
        {% endif %}
    </div>

    {% if is_model %}
        <div class="alert alert-info" role="status">
            {{ 'This page is the model of its type: new pages of the type start as a copy of it. It is never published and is not listed with the other pages.'|trans({}, 'theliacms') }}
        </div>
    {% endif %}

    {{ form_start(form, { attr: { id: 'cms-page-settings-form' } }) }}
        <input type="hidden" name="_token" value="{{ assignToken() }}">
        {{ form_errors(form) }}
        <div class="tab-content">
            <div class="tab-pane fade{{ seo_modules_open ? '' : ' show active' }}" id="tab-general" role="tabpanel">
                <div class="row g-3">
                    <div class="col-lg-8">
                        {{ form_row(form.title) }}
                        {% if is_home %}
                            <p class="form-text" data-testid="cms-page-home-address-note">{{ 'This is the home page: it is served at the root of the site, so it has no address to set.'|trans({}, 'theliacms') }}</p>
                        {% else %}
                            {{ form_row(form.slug) }}
                            {{ form_row(form.fixedUrl) }}
                        {% endif %}
                        {{ form_row(form.chapo, { row_attr: { 'data-cms-summary': '' } }) }}
                        {{ form_row(form.description) }}
                    </div>

                    <div class="col-lg-4">
                        {{ form_row(form.visible) }}
                        {{ form_row(form.titleBand) }}
                        {{ form_row(form.parent) }}
                        {{ form_row(form.pageType) }}
                        {{ form_row(form.tag) }}
                        {{ form_row(form.publishAt) }}
                        {{ form_row(form.unpublishAt) }}
                    </div>
                </div>
            </div>

            {% if has_fields %}
                <div class="tab-pane fade" id="tab-fields" role="tabpanel" data-testid="cms-page-fields">
                    <p class="text-muted">{{ 'The values of the fields of the type, read by the template of the page and by the lists of the type.'|trans({}, 'theliacms') }}</p>
                    <div class="row g-3">
                        {% for field in form.fields %}
                            <div class="col-md-6">{{ form_row(field) }}</div>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                {% do form.fields.setRendered %}
            {% endif %}

            <div class="tab-pane fade" id="tab-seo" role="tabpanel">
                <div class="row g-3">
                    <div class="col-lg-8">
                        {{ form_row(form.metaTitle) }}
                        {{ form_row(form.metaDescription) }}
                        {{ form_row(form.ogTitle) }}
                        {{ form_row(form.ogDescription) }}
                        {{ form_row(form.ogImage) }}
                        {{ form_row(form.canonical) }}
                    </div>

                    <div class="col-lg-4">
                        {{ form_row(form.twitterCard) }}
                        {{ form_row(form.noindex) }}
                        {{ form_row(form.nofollow) }}
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-image" role="tabpanel">
                {# The image is drawn and picked in the media library by the
                   script; without it, its id. #}
                {{ form_row(form.image) }}
                {% if form.imageUpload is defined %}
                    {{ form_row(form.imageUpload, { attr: { accept: 'image/jpeg,image/png,image/webp' } }) }}
                {% endif %}
            </div>
        </div>

    {{ form_end(form) }}

    {% if not is_new and not is_model and may_publish %}
        <form method="post" id="cms-page-publish-form" action="{{ path('admin.cms.pages.publish', { id: page.id, edit_language_id: edit_language_id }|merge(return_query)) }}">
            <input type="hidden" name="_token" value="{{ assignToken() }}">
        </form>
        <form method="post" id="cms-page-unpublish-form" action="{{ path('admin.cms.pages.unpublish', { id: page.id, edit_language_id: edit_language_id }|merge(return_query)) }}">
            <input type="hidden" name="_token" value="{{ assignToken() }}">
        </form>
    {% endif %}

    {% if not is_new %}
        {# After the form, not in it: its forms are not part of the draft. #}
        <div class="tab-content">
            {% if seo_module_cards|trim is not empty %}
                {# The SEO a module adds to a page (SEOne: robots, H1, structured data), on the hooks the
                   catalogue screens call in their SEO tab. Each card brings its own form, saved by its
                   module: out of the settings form, as the documents. #}
                <div class="tab-pane fade{{ seo_modules_open ? ' show active' : '' }}" id="tab-seo-modules" role="tabpanel" data-testid="cms-page-seo-modules">
                    {# The bar under the panels saves the settings of the page only: each card here has its own button. #}
                    <p class="form-text mt-0 mb-3" data-testid="cms-page-seo-modules-help">{{ 'Each card is saved by its own button. The Save of the page saves the settings of the page only.'|trans({}, 'theliacms') }}</p>
                    {{ seo_module_cards }}
                </div>
            {% endif %}
            {{ include('@TheliaCMSModule/backOffice/default-twig/pages/_documents.html.twig') }}
        </div>
    {% endif %}

    {% set can_publish = may_publish and not is_new and not is_model %}
    {% if may_change %}
        {# One bar on every tab, after every panel: inside the settings form it stayed above the
           Documents panel, which comes after that form. Each button names its form by `form`: Save
           and Save and publish the settings, Publish and Unpublish their own POST. #}
        <div class="cms-page-actions sticky-md-bottom bg-body border-top mt-3 py-2" data-cms-page-save-bar>
            <div class="d-flex flex-wrap gap-2" role="group" aria-label="{{ 'Page actions'|trans({}, 'theliacms') }}" data-testid="cms-page-actions">
                <button type="submit" form="cms-page-settings-form" class="btn btn-outline-primary" aria-describedby="cms-page-actions-help" data-cms-save-actions data-testid="cms-page-save">{{ 'Save'|trans({}, 'theliacms') }}</button>
                {% if can_publish %}
                    <button type="submit" form="cms-page-settings-form" name="save_and_publish" value="1" class="btn btn-success" aria-describedby="cms-page-actions-help" data-cms-save-actions data-testid="cms-page-save-and-publish">{{ 'Save and publish'|trans({}, 'theliacms') }}</button>
                    <button type="submit" form="cms-page-publish-form" class="btn btn-outline-success" aria-describedby="cms-page-actions-help" data-cms-publish-only data-testid="cms-page-publish">{{ 'Publish'|trans({}, 'theliacms') }}</button>
                    <button type="submit" form="cms-page-unpublish-form" class="btn btn-outline-secondary" data-testid="cms-page-unpublish">{{ 'Unpublish'|trans({}, 'theliacms') }}</button>
                {% endif %}
            </div>
            <p class="form-text mb-0 mt-1" id="cms-page-actions-help">
                {{ 'The settings are live as soon as they are saved. The content goes online when you publish it.'|trans({}, 'theliacms') }}
                {% if can_publish %}{{ 'Save and publish saves what is typed here, then puts the saved content online. Publish only puts the content already saved online.'|trans({}, 'theliacms') }}{% endif %}
            </p>
        </div>
    {% endif %}

{% endblock %}

{% block scripts_extra %}
    {{ parent() }}
    {{ safe_hook('wysiwyg.js', { location: 'cms-page-edit-js' }) }}
    <script src="{{ cms_asset('assets/page-address.js') }}?v={{ assets_version }}" defer></script>
    {% if not is_new %}
        <script src="{{ cms_asset('assets/page-documents.js') }}?v={{ assets_version }}" defer></script>
    {% endif %}
    <script src="{{ cms_asset('assets/page-actions.js') }}?v={{ assets_version }}" defer></script>
    {{ include('@TheliaCMSModule/backOffice/default-twig/media/_picker.html.twig', { media_picker_version: assets_version }) }}
{% endblock %}
