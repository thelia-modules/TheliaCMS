{#
    Flash messages of the builder screens, shown as notices over the canvas.

    The builder replaces the whole body of the layout, so the messages of the
    theme are not rendered on these screens — and a banner at the top of the
    page would push the canvas down every time something is saved.

    Accessibility: a warning or a confirmation is announced politely and
    dismisses itself; an error is announced assertively and stays until it is
    closed, because it is the one the reader has to act on. Every notice can be
    closed by hand, and the countdown stops while the pointer or the keyboard
    focus is on it.
#}
{% set toast_icons = {
    success: 'bi-check-circle-fill',
    danger: 'bi-exclamation-octagon-fill',
    warning: 'bi-exclamation-triangle-fill',
    info: 'bi-info-circle-fill',
} %}

{% set flashes = app.flashes %}

{% if flashes is not empty %}
    <div class="cms-toasts">
        {% for type, messages in flashes %}
            {% for message in messages %}
                <div class="cms-toast cms-toast--{{ type }}"
                     data-controller="cms-toast"
                     data-cms-toast-permanent-value="{{ type == 'danger' ? 'true' : 'false' }}"
                     role="{{ type == 'danger' ? 'alert' : 'status' }}"
                     data-testid="cms-builder-flash-{{ type }}">
                    <i class="bi {{ toast_icons[type]|default('bi-info-circle-fill') }} cms-toast__icon" aria-hidden="true"></i>
                    <p class="cms-toast__message">{{ message }}</p>
                    <button type="button" class="cms-toast__close" data-action="cms-toast#close"
                            aria-label="{{ 'Close'|trans({}, 'theliacms') }}">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
{% endif %}
