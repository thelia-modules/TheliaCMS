{#
    Flash messages of the full-window screens, shown as notices over the stage.

    These screens replace the whole body of the layout, so the messages of the
    theme are not rendered on them — and a banner at the top of the page would
    push the stage down every time something is saved.

    `extra` carries messages that are not flashes: the outcome of a call a
    screen reads from its own records. Each is `{type, message, details}`.

    Accessibility: a warning or a confirmation is announced politely and
    dismisses itself; an error is announced assertively and stays until it is
    closed, because it is the one the reader has to act on. Every notice can be
    closed by hand, and the countdown stops while the pointer or the keyboard
    focus is on it.
#}
{% set toast_icons = {
    success: 'bi-check-circle-fill',
    danger: 'bi-exclamation-octagon-fill',
    warning: 'bi-exclamation-triangle-fill',
    info: 'bi-info-circle-fill',
} %}

{% set notices = [] %}
{% for type, messages in app.flashes %}
    {% for message in messages %}
        {% set notices = notices|merge([{ type: type, message: message, details: [] }]) %}
    {% endfor %}
{% endfor %}
{% for notice in extra|default([]) %}
    {% set notices = notices|merge([notice]) %}
{% endfor %}

{% if notices is not empty %}
    <div class="cms-toasts">
        {% for notice in notices %}
            <div class="cms-toast cms-toast--{{ notice.type }}"
                 data-controller="cms-toast"
                 data-cms-toast-permanent-value="{{ notice.type == 'danger' ? 'true' : 'false' }}"
                 role="{{ notice.type == 'danger' ? 'alert' : 'status' }}"
                 data-testid="cms-builder-flash-{{ notice.type }}">
                <i class="bi {{ toast_icons[notice.type]|default('bi-info-circle-fill') }} cms-toast__icon" aria-hidden="true"></i>
                <div class="cms-toast__message">
                    <p class="mb-0">{{ notice.message }}</p>
                    {% for detail in notice.details|default([])|filter(detail => detail is not empty) %}
                        <p class="mb-0 small text-muted">{{ detail }}</p>
                    {% endfor %}
                </div>
                <button type="button" class="cms-toast__close" data-action="cms-toast#close"
                        aria-label="{{ 'Close'|trans({}, 'theliacms') }}">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
        {% endfor %}
    </div>
{% endif %}
