{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Page templates'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-page-types{% endblock %}

{% block content %}
    {% form_theme form with bo_form_themes only %}

    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Page templates'|trans({}, 'theliacms') } %}
        {% block actions %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.settings.edit') }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to settings'|trans({}, 'theliacms') }}
            </a>
        {% endblock %}
    {% endembed %}

    <p class="text-muted">
        {{ 'The type of a page picks the template it is displayed with: cmspage-{code}.html.twig in the theme, otherwise the usual page template.'|trans({}, 'theliacms') }}
        {{ 'A type is also a template of pages: a brief, fields its pages carry and a model new pages start from.'|trans({}, 'theliacms') }}
    </p>

    {% set template_sources = {
        'theme': 'Theme'|trans({}, 'theliacms'),
        'module': 'Thelia CMS module'|trans({}, 'theliacms'),
        'theme-fallback': 'Usual page template of the theme'|trans({}, 'theliacms'),
        'module-fallback': 'Usual page template of the module'|trans({}, 'theliacms'),
    } %}

    <div class="card mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">{{ 'Page template'|trans({}, 'theliacms') }}</th>
                        <th scope="col">{{ 'Brief, fields and model'|trans({}, 'theliacms') }}</th>
                        <th scope="col">{{ 'Displayed with'|trans({}, 'theliacms') }}</th>
                        <th scope="col">{{ 'Pages'|trans({}, 'theliacms') }}</th>
                        <th scope="col" class="text-end">{{ 'Actions'|trans({}, 'theliacms') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in types %}
                        <tr data-testid="cms-page-type-row-{{ row.code }}">
                            <td>
                                <a class="fw-medium" href="{{ path('admin.cms.settings.page_types.edit', { code: row.code }) }}" data-testid="cms-page-type-edit-{{ row.code }}">{{ row.title }}</a>
                                {% if row.title != row.code %}<div><code class="small">{{ row.code }}</code></div>{% endif %}
                            </td>
                            <td class="small" data-testid="cms-page-type-template-of-{{ row.code }}">
                                {% if row.fields > 0 %}<div>{{ '%count% field(s)'|trans({ '%count%': row.fields }, 'theliacms') }}</div>{% endif %}
                                {% if row.has_brief %}<div>{{ 'Brief'|trans({}, 'theliacms') }}</div>{% endif %}
                                {% if row.has_model %}<div>{{ 'Model page'|trans({}, 'theliacms') }}</div>{% endif %}
                                {% if row.fields == 0 and not row.has_brief and not row.has_model %}<span class="text-muted">—</span>{% endif %}
                            </td>
                            <td data-testid="cms-page-type-template-{{ row.code }}" data-source="{{ row.template.source.value }}">
                                <div>{{ template_sources[row.template.source.value] }}</div>
                                <code class="text-muted small">{{ row.template.name }}</code>
                            </td>
                            <td>{{ row.pages }}</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.settings.page_types.edit', { code: row.code }) }}">{{ 'Edit'|trans({}, 'theliacms') }}</a>
                                {% if may_delete and row.deletable %}
                                    <form method="post"
                                          action="{{ path('admin.cms.settings.page_types.delete', { code: row.code }) }}"
                                          onsubmit="return confirm('{{ 'Delete this page template? Its model page goes with it.'|trans({}, 'theliacms')|e('js') }}')">
                                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="{{ 'Delete'|trans({}, 'theliacms') }}" data-testid="cms-page-type-delete-{{ row.code }}">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if may_create %}
        <div class="card">
            <div class="card-header">{{ 'Add a page template'|trans({}, 'theliacms') }}</div>
            <div class="card-body">
                {{ form_start(form) }}
                    <input type="hidden" name="_token" value="{{ assignToken() }}">
                    {{ form_row(form.code) }}
                    <button class="btn btn-primary" type="submit" data-testid="cms-page-type-add">
                        {{ 'Add'|trans({}, 'theliacms') }}
                    </button>
                {{ form_end(form) }}
            </div>
        </div>
    {% endif %}
{% endblock %}
