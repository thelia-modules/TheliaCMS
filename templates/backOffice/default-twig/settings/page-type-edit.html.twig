{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Page template'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-page-type-edit{% endblock %}

{% block head_extra %}
    {# Same cap as the side panel of the forms screen: a sticky panel taller
       than the window would push its own button out of reach. #}
    <style>
        .cms-form-side-panel { max-height: calc(100vh - 2rem); overflow-y: auto; }
    </style>
{% endblock %}

{% block content %}
    {% form_theme settings_form with bo_form_themes only %}
    {% form_theme field_form with bo_form_themes only %}

    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: block('title') } %}
        {% block title %}
            {{ type_title }} <code class="ms-2 fs-6">{{ type.code }}</code>
        {% endblock %}

        {% block actions %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.settings.page_types.list', { edit_language_id: edit_language_id }) }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to page templates'|trans({}, 'theliacms') }}
            </a>
        {% endblock %}
    {% endembed %}

    <p class="text-muted">
        {{ 'Pages of this type are displayed with %template%, are written from the brief below before their own, and carry the fields listed here. A new page of the type starts as a copy of its model.'|trans({ '%template%': template.name }, 'theliacms') }}
        {{ '%count% page(s) of this type, the bin included.'|trans({ '%count%': pages }, 'theliacms') }}
    </p>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card mb-3" data-testid="cms-page-type-model">
                <div class="card-header">{{ 'Model page'|trans({}, 'theliacms') }}</div>
                <div class="card-body">
                    {% if model %}
                        <p class="mb-2">{{ 'The demo content new pages of this type are copied from. It is never published, and is not listed with the other pages.'|trans({}, 'theliacms') }}</p>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-primary" href="{{ path('admin.cms.pages.content.edit', { id: model.id, edit_language_id: edit_language_id }) }}" data-testid="cms-page-type-model-content">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i> {{ 'Edit the content of the model'|trans({}, 'theliacms') }}
                            </a>
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.pages.edit', { id: model.id, edit_language_id: edit_language_id }) }}">
                                {{ 'Settings and fields of the model'|trans({}, 'theliacms') }}
                            </a>
                        </div>
                    {% else %}
                        <p class="mb-2">{{ 'This type has no model yet: new pages of the type start empty. Create one, then write its demo content from a brief or by hand.'|trans({}, 'theliacms') }}</p>
                        {% if may_update %}
                            <form method="post" action="{{ path('admin.cms.settings.page_types.model', { code: type.code, edit_language_id: edit_language_id }) }}">
                                <input type="hidden" name="_token" value="{{ assignToken() }}">
                                <button class="btn btn-sm btn-primary" type="submit" data-testid="cms-page-type-model-create">
                                    {{ 'Create the model page'|trans({}, 'theliacms') }}
                                </button>
                            </form>
                        {% endif %}
                    {% endif %}
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span>{{ 'Fields of the pages'|trans({}, 'theliacms') }}</span>
                    {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
                </div>

                {% if rows is empty %}
                    <div class="card-body text-muted" data-testid="cms-page-type-no-field">
                        {{ 'No field yet. A field is a value every page of the type carries, such as the number of servings of a recipe: lists of the type can sort and filter on it.'|trans({}, 'theliacms') }}
                    </div>
                {% else %}
                    <div class="bo-table-wrap">
                        <table class="table table-hover align-middle mb-0">
                            <tbody>
                                {% for row in rows %}
                                    <tr class="{{ edited_field and edited_field.code == row.field.code ? 'table-active' : '' }}" data-testid="cms-page-type-field-{{ row.field.code }}">
                                        <td>
                                            <span class="fw-medium">{{ row.label }}</span>
                                            {% if row.field.required %}
                                                <span class="text-danger ms-1" aria-label="{{ 'Required'|trans({}, 'theliacms') }}">*</span>
                                            {% endif %}
                                            <span class="badge bg-light text-dark border ms-2">{{ row.field.kind.label|trans({}, 'theliacms') }}</span>
                                            {% if row.field.translated %}
                                                <span class="badge bg-light text-dark border ms-1">{{ 'Per language'|trans({}, 'theliacms') }}</span>
                                            {% endif %}
                                            <div class="small text-muted"><code>cms_page.fields.{{ row.field.code }}</code>{% if row.field.unit %} · {{ row.field.unit }}{% endif %}</div>
                                            {% if not row.has_label %}
                                                <div class="small text-warning-emphasis">
                                                    <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                                                    {{ 'No label in this language: the label of another one is shown.'|trans({}, 'theliacms') }}
                                                </div>
                                            {% endif %}
                                        </td>
                                        <td class="text-end" style="width: 12rem">
                                            {% if may_update %}
                                                <div class="d-inline-flex gap-1">
                                                    <form method="post" action="{{ path('admin.cms.settings.page_types.field_move', { code: type.code, field: row.field.code, direction: 'up', edit_language_id: edit_language_id }) }}">
                                                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                                                        <button class="btn btn-sm btn-outline-secondary" type="submit" aria-label="{{ 'Move up'|trans({}, 'theliacms') }}" {{ row.can_move_up ? '' : 'disabled' }}>
                                                            <i class="bi bi-arrow-up" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                    <form method="post" action="{{ path('admin.cms.settings.page_types.field_move', { code: type.code, field: row.field.code, direction: 'down', edit_language_id: edit_language_id }) }}">
                                                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                                                        <button class="btn btn-sm btn-outline-secondary" type="submit" aria-label="{{ 'Move down'|trans({}, 'theliacms') }}" {{ row.can_move_down ? '' : 'disabled' }}>
                                                            <i class="bi bi-arrow-down" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.settings.page_types.field_save', { code: type.code, field: row.field.code, edit_language_id: edit_language_id }) }}">
                                                        {{ 'Edit'|trans({}, 'theliacms') }}
                                                    </a>
                                                    <form method="post" action="{{ path('admin.cms.settings.page_types.field_delete', { code: type.code, field: row.field.code, edit_language_id: edit_language_id }) }}"
                                                          onsubmit="return confirm('{{ 'Remove this field? The values pages hold for it are no longer shown.'|trans({}, 'theliacms')|e('js') }}')">
                                                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                                                        <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="{{ 'Delete'|trans({}, 'theliacms') }}" data-testid="cms-page-type-field-delete-{{ row.field.code }}">
                                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>

            <div class="card">
                <div class="card-header">{{ 'Name and brief'|trans({}, 'theliacms') }}</div>
                <div class="card-body">
                    {{ form_start(settings_form) }}
                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                        {{ form_row(settings_form.title) }}
                        {{ form_row(settings_form.description) }}
                        {{ form_row(settings_form.briefText) }}
                        <div class="row">
                            <div class="col-md-6">{{ form_row(settings_form.briefTone) }}</div>
                            <div class="col-md-6">{{ form_row(settings_form.briefAudience) }}</div>
                        </div>
                        {% if may_update %}
                            <button type="submit" class="btn btn-primary" data-testid="cms-page-type-save">{{ 'Save'|trans({}, 'theliacms') }}</button>
                        {% endif %}
                    {{ form_end(settings_form) }}
                </div>
            </div>
        </div>

        {% if may_update %}
            <div class="col-lg-5">
                <div class="card position-sticky cms-form-side-panel" style="top: 1rem">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>{{ edited_field ? 'Edit field'|trans({}, 'theliacms') : 'Add a field'|trans({}, 'theliacms') }}</span>
                        {% if edited_field %}
                            <a class="btn btn-sm btn-link p-0" href="{{ path('admin.cms.settings.page_types.edit', { code: type.code, edit_language_id: edit_language_id }) }}">
                                {{ 'Cancel'|trans({}, 'theliacms') }}
                            </a>
                        {% endif %}
                    </div>
                    <div class="card-body">
                        {{ form_start(field_form) }}
                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                            {{ form_errors(field_form) }}
                            {{ form_row(field_form.kind) }}
                            {{ form_row(field_form.label) }}
                            {{ form_row(field_form.code) }}
                            {{ form_row(field_form.unit) }}
                            {{ form_row(field_form.choices) }}
                            <div class="row" data-cms-field-setting="bounds">
                                <div class="col" data-cms-field-setting="min">{{ form_row(field_form.min) }}</div>
                                <div class="col">{{ form_row(field_form.max) }}</div>
                            </div>
                            {{ form_row(field_form.translated) }}
                            {{ form_row(field_form.required) }}

                            <button type="submit" class="btn btn-primary" data-testid="cms-page-type-field-submit">
                                {{ edited_field ? 'Save the field'|trans({}, 'theliacms') : 'Add the field'|trans({}, 'theliacms') }}
                            </button>
                        {{ form_end(field_form) }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block scripts_extra %}
    {{ parent() }}
    {# Shows only the settings the chosen kind of field has. The server reads
       the whole form either way and says what does not hold together. #}
    <script>
        (function () {
            var select = document.querySelector('[data-cms-field-type-select]');

            if (!select) {
                return;
            }

            var applies = {
                unit: ['integer', 'decimal'],
                choices: ['choice'],
                bounds: ['integer', 'decimal', 'duration', 'text', 'longtext'],
                min: ['integer', 'decimal', 'duration'],
                translated: ['text', 'longtext']
            };

            function refresh() {
                Object.keys(applies).forEach(function (setting) {
                    document.querySelectorAll('[data-cms-field-setting="' + setting + '"]').forEach(function (row) {
                        row.hidden = applies[setting].indexOf(select.value) === -1;
                    });
                });
            }

            select.addEventListener('change', refresh);
            refresh();
        })();
    </script>
{% endblock %}
