{#
    The props of one section, by hand: a field per prop, read from the schema
    of its component. A list prop is a set of rows the script adds and removes
    from the prototype of the collection; without the script, the rows the
    section holds are editable and nothing more.
#}
{% macro fields(form) %}
    {% for child in form.children %}
        {% if child.rendered %}
            {# Already drawn with the field it goes with. #}
        {% elseif child.vars.name == 'section' %}
            {{ form_widget(child) }}
        {% elseif child.vars.name ends with '__file' or child.vars.name ends with '__url' %}
            {# The other sources of a picture, folded under its choice: open
               when an address is already there. #}
            {% set base = child.vars.name|split('__')|first %}
            {% set file = form.children[base ~ '__file'] ?? null %}
            {% set address = form.children[base ~ '__url'] ?? null %}
            <details class="cms-content__more" {{ address and address.vars.value ? 'open' }}>
                <summary>{{ (address ? 'Another source: a file or an address' : 'Another source: a file')|trans({}, 'theliacms') }}</summary>
                {% if file %}{{ form_row(file) }}{% endif %}
                {% if address %}{{ form_row(address) }}{% endif %}
            </details>
        {% elseif child.vars.name == 'focus_x' and form.children['focus_y'] is defined and form.children['zoom'] is not defined %}
            {# The kept part of a picture given as two numbers: folded, open
               on an error. A picture with a zoom is framed on its own sentence. #}
            {% set focus_y = form.children['focus_y'] %}
            <details class="cms-content__more" {{ child.vars.valid and focus_y.vars.valid ? '' : 'open' }}>
                <summary>{{ 'Kept part of the picture'|trans({}, 'theliacms') }}</summary>
                <div class="cms-content__item-fields">
                    {{ form_row(child) }}
                    {{ form_row(focus_y) }}
                </div>
            </details>
        {% elseif child.vars.attr['data-cms-choice-buttons'] is defined %}
            {{ _self.choice_buttons(child) }}
        {% elseif child.vars.name == 'cms_appearance' %}
            {# How the section stands out, besides its props: folded, open
               when the section already has a look of its own. #}
            <details class="cms-content__appearance cms-content__more" data-testid="cms-section-appearance" {{ child.vars.value|filter(value => value is not empty)|length > 0 ? 'open' }}>
                <summary>{{ child.vars.label|trans({}, 'theliacms') }}</summary>
                <div class="cms-content__appearance-fields">
                    {# The two colours side by side, each with its help under
                       its field so both fields stand on one line; then the
                       room and the alignment, each a row of buttons. #}
                    <div class="cms-content__colors">
                        {% for setting in child|filter(setting => setting.vars.attr['data-cms-color'] is defined) %}
                            {{ _self.color(setting) }}
                        {% endfor %}
                    </div>
                    {% for setting in child|filter(setting => not setting.rendered and setting.vars.attr['data-cms-spacing'] is not defined) %}
                        {% if setting.vars.attr['data-cms-choice-buttons'] is defined %}
                            {{ _self.choice_buttons(setting) }}
                            {% if setting.vars.name == 'padding' %}
                                {{ _self.spacing(child) }}
                            {% endif %}
                        {% else %}
                            {{ form_row(setting) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </details>
            {% do child.setRendered %}
        {% elseif child.vars.prototype is defined %}
            {# The script renames the fields of the rows to the order they are
               in, from the name of the collection: the form keeps the rows in
               the order of their indexes, not in the order they are sent. #}
            <fieldset class="cms-content__items" data-cms-items
                      data-cms-items-name="{{ child.vars.full_name }}"
                      data-cms-items-min="{{ child.vars.attr['data-cms-items-min']|default(0) }}"
                      data-cms-items-max="{{ child.vars.attr['data-cms-items-max']|default(12) }}"
                      data-cms-items-moved="{{ 'Row moved to position %position% of %total%'|trans({}, 'theliacms')|e('html_attr') }}"
                      data-prototype="{{ _self.item(child.vars.prototype, child.vars.full_name ~ '[__name__]')|e('html_attr') }}">
                {# Translated as the label and the help of any other field. #}
                {% set domain = child.vars.translation_domain %}
                <legend class="cms-content__items-legend">{{ domain is same as(false) ? child.vars.label : child.vars.label|trans(child.vars.label_translation_parameters, domain) }} <span class="cms-content__items-count" data-cms-items-count>{{ child|length }} / {{ child.vars.attr['data-cms-items-max']|default(12) }}</span></legend>
                {% if child.vars.help %}<p class="form-text mt-0">{{ domain is same as(false) ? child.vars.help : child.vars.help|trans(child.vars.help_translation_parameters, domain) }}</p>{% endif %}
                <ol class="cms-content__items-list" data-cms-items-list>
                    {% for item in child %}
                        {{ _self.item(item) }}
                    {% endfor %}
                </ol>
                <p class="visually-hidden" role="status" aria-live="polite" data-cms-items-status></p>
                {# A list of one row at most is an object (a button): added by its name. #}
                <button type="button" class="btn btn-sm btn-outline-secondary" data-cms-items-add hidden>
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 1 == child.vars.attr['data-cms-items-max']|default(12) ? 'Add %label%'|trans({'%label%': domain is same as(false) ? child.vars.label : child.vars.label|trans(child.vars.label_translation_parameters, domain)}, 'theliacms') : 'Add a row'|trans({}, 'theliacms') }}
                </button>
                {% do child.setRendered %}
            </fieldset>
        {% else %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}
{% endmacro %}

{#
    A choice with a pictogram per value: a row of buttons, the pictogram
    above the words. Radio buttons underneath, so the form sends what it
    always sent and the keyboard moves through them as through any radios.
#}
{% macro choice_buttons(field) %}
    {% set domain = field.vars.translation_domain %}
    <fieldset class="mb-3" data-cms-choice-buttons data-testid="cms-choice-{{ field.vars.name }}">
        <legend class="form-label fs-6 mb-1">{{ domain is same as(false) ? field.vars.label : field.vars.label|trans({}, domain) }}</legend>
        {% if field.vars.help %}
            <div class="form-text mt-0 mb-2">{{ domain is same as(false) ? field.vars.help : field.vars.help|trans({}, domain) }}</div>
        {% endif %}
        <div class="cms-content__choices">
            {% for option in field %}
                {% set option_domain = option.vars.translation_domain %}
                <input type="radio" class="btn-check" id="{{ option.vars.id }}" name="{{ option.vars.full_name }}"
                       value="{{ option.vars.value }}" {{ option.vars.checked ? 'checked' }} autocomplete="off">
                <label class="btn btn-outline-secondary d-flex flex-column align-items-center justify-content-center gap-1 py-2" for="{{ option.vars.id }}">
                    {{ _self.icon(option.vars.attr['data-cms-icon']|default('bi-dash-circle')) }}
                    <span class="small lh-sm">{{ option_domain is same as(false) ? option.vars.label : option.vars.label|trans({}, option_domain) }}</span>
                </label>
                {% do option.setRendered %}
            {% endfor %}
        </div>
        {{ form_errors(field) }}
    </fieldset>
    {% do field.setRendered %}
{% endmacro %}

{#
    The precise room of a section, drawn as the box model of a browser's
    tools: the outer room (margin) around the inner room (padding) around
    the content, a field on each side of each box. The group holds the eight
    fields, named padding_top, padding_bottom, padding_left, padding_right
    and the same for margin; each keeps its label for a screen reader.
    Served shown, under the room buttons; the script hides it unless
    "Precise room" is checked.
#}
{% macro spacing(group) %}
    <fieldset class="mb-3 cms-content__spacing" data-testid="cms-section-spacing" data-cms-precise-room>
        <legend class="visually-hidden">{{ 'Precise room'|trans({}, 'theliacms') }}</legend>
        <div class="cms-box cms-box--margin" data-testid="cms-spacing-margin">
            <span class="cms-box__name" aria-hidden="true">{{ 'Outside'|trans({}, 'theliacms') }}</span>
            {{ _self.box_side(group.margin_top, 'top') }}
            {{ _self.box_side(group.margin_left, 'left') }}
            <div class="cms-box cms-box--padding" data-testid="cms-spacing-padding">
                <span class="cms-box__name" aria-hidden="true">{{ 'Inside'|trans({}, 'theliacms') }}</span>
                {{ _self.box_side(group.padding_top, 'top') }}
                {{ _self.box_side(group.padding_left, 'left') }}
                <div class="cms-box cms-box--content" aria-hidden="true">{{ 'Content'|trans({}, 'theliacms') }}</div>
                {{ _self.box_side(group.padding_right, 'right') }}
                {{ _self.box_side(group.padding_bottom, 'bottom') }}
            </div>
            {{ _self.box_side(group.margin_right, 'right') }}
            {{ _self.box_side(group.margin_bottom, 'bottom') }}
        </div>
        <div class="form-text">{{ group.padding_top.vars.help|trans({}, group.padding_top.vars.translation_domain) }}</div>
        <div class="form-text">{{ group.margin_top.vars.help|trans({}, group.margin_top.vars.translation_domain) }}</div>
        {% for field in [group.padding_top, group.padding_bottom, group.padding_left, group.padding_right, group.margin_top, group.margin_bottom, group.margin_left, group.margin_right] %}
            {{ form_errors(field) }}
        {% endfor %}
    </fieldset>
{% endmacro %}

{#
    One side of a box of the precise room: the field alone, its label read
    by a screen reader only, the box saying where it stands.
#}
{% macro box_side(field, side) %}
    <div class="cms-box__side cms-box__side--{{ side }}">
        <label class="visually-hidden" for="{{ field.vars.id }}">{{ field.vars.label|trans({}, field.vars.translation_domain) }}</label>
        {{ form_widget(field, {attr: field.vars.attr|merge({placeholder: '-', title: field.vars.label|trans({}, field.vars.translation_domain)})}) }}
    </div>
{% endmacro %}

{#
    A colour of the appearance: its name, the field the script pairs with a
    swatch, its help under it.
#}
{% macro color(field) %}
    {% set domain = field.vars.translation_domain %}
    <div class="mb-3">
        <label class="form-label" for="{{ field.vars.id }}">{{ domain is same as(false) ? field.vars.label : field.vars.label|trans({}, domain) }}</label>
        {{ form_widget(field) }}
        {% if field.vars.help %}
            <div class="form-text">{{ domain is same as(false) ? field.vars.help : field.vars.help|trans({}, domain) }}</div>
        {% endif %}
        {{ form_errors(field) }}
    </div>
{% endmacro %}

{#
    The pictograms of the module, drawn here so a width or a room shows its
    shape; any other name is one of Bootstrap Icons.
#}
{% macro icon(name) %}
    {% set widths = { 'width-narrow': 14, 'width-column': 26, 'width-full': 40 } %}
    {% set rooms = { 'space-small': 3, 'space-medium': 6, 'space-large': 9 } %}
    {% if widths[name] is defined %}
        {% set width = widths[name] %}
        <svg width="40" height="28" viewBox="0 0 40 28" aria-hidden="true">
            <rect x="0.5" y="0.5" width="39" height="27" rx="2" fill="none" stroke="currentColor" opacity=".5"/>
            <rect x="{{ (40 - width) / 2 }}" y="7" width="{{ width }}" height="14" rx="1" fill="currentColor"/>
        </svg>
    {% elseif name starts with 'ratio-' %}
        {# The shape of a proportion, `ratio-16-9`: a rectangle of that ratio in the frame. #}
        {% set sides = name|slice(6)|split('-') %}
        {% set shape = (sides[0] / sides[1]) >= 1 ? { w: 24, h: 24 / (sides[0] / sides[1]) } : { w: 22 * (sides[0] / sides[1]), h: 22 } %}
        <svg width="40" height="28" viewBox="0 0 40 28" aria-hidden="true">
            <rect x="0.5" y="0.5" width="39" height="27" rx="2" fill="none" stroke="currentColor" opacity=".5"/>
            <rect x="{{ (40 - shape.w) / 2 }}" y="{{ (28 - shape.h) / 2 }}" width="{{ shape.w }}" height="{{ shape.h }}" rx="1" fill="currentColor"/>
        </svg>
    {% elseif rooms[name] is defined %}
        {% set room = rooms[name] %}
        <svg width="40" height="28" viewBox="0 0 40 28" aria-hidden="true">
            <line x1="2" y1="1" x2="38" y2="1" stroke="currentColor" opacity=".5"/>
            <line x1="2" y1="27" x2="38" y2="27" stroke="currentColor" opacity=".5"/>
            <rect x="8" y="{{ 1 + room }}" width="24" height="{{ 26 - 2 * room }}" rx="1" fill="currentColor"/>
        </svg>
    {% else %}
        <i class="bi {{ name }} fs-4 lh-1" aria-hidden="true"></i>
    {% endif %}
{% endmacro %}

{#
    A row is folded under its number and its first words, the first text it
    holds, so a list of slides, blocks or panels reads as a list: a new row,
    and a row with an error, open. The tools of a row (up, down, remove) sit
    beside the fold, never inside its summary. The script keeps the words of
    the summary in step with the field they come from, named by its id.
#}
{% macro item(item) %}
    {# The first text that says something: a line of text, else a text of
       paragraphs, so a slide made of one text still reads by its words. #}
    {% set texts = item.children|filter(child => 'text' in child.vars.block_prefixes and child.vars.value is not iterable and child.vars.attr['data-cms-image-picker'] is not defined and child.vars.attr['data-cms-video-picker'] is not defined and child.vars.attr.placeholder is not defined and not (child.vars.name ends with '__url')) %}
    {# Where a row leads (the `href` of a button) names it only when nothing
       else does: a button reads by what it says. #}
    {% set links = texts|filter(child => child.vars.attr['data-cms-html'] is not defined and ('url' in child.vars.block_prefixes or child.vars.name in ['href', 'url', 'link'] or child.vars.name ends with '_url' or child.vars.name ends with '_link')) %}
    {% set lines = texts|filter(child => child.vars.attr['data-cms-html'] is not defined and child not in links) %}
    {% set paragraphs = texts|filter(child => child.vars.attr['data-cms-html'] is defined) %}
    {% set named = lines|filter(child => (child.vars.value ?? '')|trim is not empty)|first ?: paragraphs|filter(child => (child.vars.value ?? '')|striptags|trim is not empty)|first ?: links|filter(child => (child.vars.value ?? '')|trim is not empty)|first ?: lines|first ?: paragraphs|first ?: links|first %}
    {# A row of records alone (the products of a band) reads by the name of
       the first one: the script draws it once the picker has it. #}
    {% set record = named ? null : item.children|filter(child => child.vars.attr['data-cms-picker'] is defined)|first %}
    {# A space before each tag, so two paragraphs do not run into one word. #}
    {% set words = named ? (named.vars.value ?? '')|replace({'<': ' <'})|striptags|trim : '' %}
    {% set empty = 'A row without a title'|trans({}, 'theliacms') %}
    <li class="cms-content__item-row" data-cms-item>
        {# Dragged by this handle only, like a section; the arrows stay the way
           to do it from the keyboard. #}
        <span class="cms-content__item-grip cms-content__item-row-grip" data-cms-item-grip hidden
              title="{{ 'Drag to move this row'|trans({}, 'theliacms') }}" aria-hidden="true"><i class="bi bi-grip-vertical"></i></span>
        <details class="cms-content__item-fold" {{ item.vars.value is empty or not item.vars.valid ? 'open' }}>
            <summary class="cms-content__item-summary"><span class="cms-content__item-title" data-cms-item-title data-cms-item-empty="{{ empty|e('html_attr') }}" {% if named %}data-cms-item-source="{{ named.vars.id }}"{% elseif record %}data-cms-item-source="{{ record.vars.id }}_picker"{% endif %}>{{ words is not empty ? words|slice(0, 80) : empty }}</span></summary>
            <div class="cms-content__item-fields">
                {{ _self.fields(item) }}
            </div>
        </details>
        <div class="cms-content__item-tools">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-cms-item-up hidden
                    aria-label="{{ 'Move this row up'|trans({}, 'theliacms') }}" title="{{ 'Move this row up'|trans({}, 'theliacms') }}">
                <i class="bi bi-arrow-up" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-cms-item-down hidden
                    aria-label="{{ 'Move this row down'|trans({}, 'theliacms') }}" title="{{ 'Move this row down'|trans({}, 'theliacms') }}">
                <i class="bi bi-arrow-down" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger cms-content__item-remove" data-cms-item-remove hidden
                    aria-label="{{ 'Remove this row'|trans({}, 'theliacms') }}" title="{{ 'Remove this row'|trans({}, 'theliacms') }}">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
    </li>
{% endmacro %}

{# The last theme of the list wins: the rows of this form come from the
   module's theme, the widgets from the back-office theme. #}
{% form_theme form with bo_form_themes|merge(['@TheliaCMSModule/backOffice/default-twig/content/_section_form_theme.html.twig']) only %}
{{ form_start(form, { attr: { 'data-cms-section-form': '', novalidate: 'novalidate' } }) }}
    <input type="hidden" name="_token" value="{{ assignToken() }}">
    {{ _self.fields(form) }}
    <div class="cms-content__edit-actions">
        <button type="submit" class="btn btn-sm btn-primary" data-testid="cms-section-save">
            {{ 'Save this section'|trans({}, 'theliacms') }}
        </button>
    </div>
{{ form_end(form, { render_rest: false }) }}
