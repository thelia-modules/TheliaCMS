{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Media'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-media-list{% endblock %}

{% block content %}
    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Media'|trans({}, 'theliacms') } %}{% endembed %}

    {# The form posts on its own so it keeps working without JavaScript:
       files chosen are sent at once. The script of the screen makes it a
       place to drop files on, sends them one by one and shows each land. #}
    <form method="post" enctype="multipart/form-data"
          class="border border-2 rounded p-3 mb-3" style="border-style: dashed !important"
          action="{{ path('admin.cms.media.add', { edit_language_id: edit_language_id }) }}"
          data-testid="cms-media-upload-form"
          data-cms-media-upload
          data-accepted="{{ accepted_mime_types }}"
          data-max-size="{{ max_upload_size }}"
          data-video-accepted="{{ accepted_video_mime_types }}"
          data-max-video-size="{{ max_video_upload_size }}"
          data-describe-url="{{ path('admin.cms.media.describe', { edit_language_id: edit_language_id }) }}"
          data-prepare-url="{{ path('admin.cms.media.svg.show', { token: token_placeholder, edit_language_id: edit_language_id }) }}"
          data-token-placeholder="{{ token_placeholder }}"
          data-messages="{{ {
              sending: 'Sending…'|trans({}, 'theliacms'),
              added: 'Added'|trans({}, 'theliacms'),
              format: 'Only JPEG, PNG, WebP and SVG images, or MP4 videos, can be uploaded.'|trans({}, 'theliacms'),
              prepared: 'To prepare'|trans({}, 'theliacms'),
              prepare: 'Prepare the SVG file|Prepare the %count% SVG files'|trans({}, 'theliacms'),
              thenDescribe: ', then describe the image|, then describe the %count% images'|trans({}, 'theliacms'),
              dropSvg: 'Do not add this SVG file|Do not add these SVG files'|trans({}, 'theliacms'),
              tooLarge: max_upload_refusal|trans({}, 'theliacms'),
              tooLargeVideo: max_video_upload_refusal|trans({}, 'theliacms'),
              failed: 'The file did not arrive whole. Send it again.'|trans({}, 'theliacms'),
              describe: 'Describe the image added|Describe the %count% images added'|trans({}, 'theliacms'),
              describeLater: 'Describe later'|trans({}, 'theliacms'),
              showVideos: 'See the video added|See the %count% videos added'|trans({}, 'theliacms'),
          }|json_encode }}">
        <input type="hidden" name="_token" value="{{ assignToken() }}">
        <div class="d-flex flex-wrap gap-3 align-items-center">
            <i class="bi bi-cloud-arrow-up fs-3 text-body-secondary" aria-hidden="true"></i>
            <div class="flex-grow-1">
                <label class="form-label mb-1 fw-medium" for="cms-media-files">{{ 'Drop images or videos here, or choose them'|trans({}, 'theliacms') }}</label>
                <input class="form-control" type="file" id="cms-media-files" name="files[]" multiple
                       accept="{{ accepted_mime_types }}" onchange="this.form.requestSubmit()">
                <div class="form-text">{{ 'JPEG, PNG, WebP or SVG images, or MP4 videos. Several at once.'|trans({}, 'theliacms') }}</div>
                {% if converts_videos %}
                    <div class="form-text" data-testid="cms-media-video-conversion-hint">{{ 'Videos from a phone (MOV, MP4, WebM, %size% MB at most) are converted for the web in the background.'|trans({ '%size%': (video_ceiling / 1048576)|round }, 'theliacms') }}</div>
                {% endif %}
                {% if video_php_limits_too_low %}
                    <div class="form-text text-warning-emphasis" data-testid="cms-media-video-php-limits">{{ 'The server accepts files of %size% MB at most (PHP upload_max_filesize and post_max_size): raise both above %ceiling% MB to send phone videos.'|trans({ '%size%': (max_video_upload_size / 1048576)|round(1), '%ceiling%': (video_ceiling / 1048576)|round }, 'theliacms') }}</div>
                {% endif %}
            </div>
            <button type="submit" class="btn btn-primary text-nowrap" data-cms-media-upload-submit>
                <i class="bi bi-upload me-1" aria-hidden="true"></i>{{ 'Add files'|trans({}, 'theliacms') }}
            </button>
        </div>
        <ul class="list-unstyled small mt-3 mb-0 d-none" data-cms-media-upload-files aria-live="polite"></ul>
        <div class="d-flex gap-2 mt-2 d-none" data-cms-media-upload-done></div>
    </form>

    {# The view is kept by every link of the screen, those that drop the
       filters included: clearing a search does not turn the rows back into
       cards. #}
    {% set in_list = query.view.value == 'list' %}
    {% set bare_list = { edit_language_id: edit_language_id }|merge(in_list ? { view: 'list' } : {}) %}

    {% if has_library %}
        {% set filter_labels = {
            'to-describe': 'To describe'|trans({}, 'theliacms'),
            'unused': 'Unused images'|trans({}, 'theliacms'),
            'decorative': 'Decorative images'|trans({}, 'theliacms'),
            'icons': 'Icons'|trans({}, 'theliacms'),
        } %}
        {% set order_labels = {
            'newest': 'Newest first'|trans({}, 'theliacms'),
            'oldest': 'Oldest first'|trans({}, 'theliacms'),
            'title': 'By title'|trans({}, 'theliacms'),
            'weight': 'Heaviest first'|trans({}, 'theliacms'),
        } %}
        {# A GET form: a filtered list is an address, bookmarked, shared or
           reloaded as it is. #}
        <form method="get" class="row g-2 align-items-start mb-3" action="{{ path('admin.cms.media.list') }}"
              data-testid="cms-media-filters">
            <input type="hidden" name="edit_language_id" value="{{ edit_language_id }}">
            {% if in_list %}<input type="hidden" name="view" value="list">{% endif %}
            <div class="col-12 col-md">
                <label class="form-label small mb-1" for="cms-media-search">{{ 'Search'|trans({}, 'theliacms') }}</label>
                <input class="form-control" type="search" id="cms-media-search" name="search" value="{{ query.search }}"
                       placeholder="{{ 'Name, description, caption or tag'|trans({}, 'theliacms') }}">
            </div>
            <div class="col-6 col-md-auto">
                <label class="form-label small mb-1" for="cms-media-filter">{{ 'Show'|trans({}, 'theliacms') }}</label>
                <select class="form-select" id="cms-media-filter" name="filter">
                    <option value="">{{ 'Every image'|trans({}, 'theliacms') }}</option>
                    {% for filter in filters %}
                        <option value="{{ filter.value }}" {{ query.filter == filter ? 'selected' }}>{{ filter_labels[filter.value] }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-auto">
                <label class="form-label small mb-1" for="cms-media-kind">{{ 'Type'|trans({}, 'theliacms') }}</label>
                <select class="form-select" id="cms-media-kind" name="kind" data-testid="cms-media-kind">
                    <option value="">{{ 'Images and videos'|trans({}, 'theliacms') }}</option>
                    {% for kind in kinds %}
                        <option value="{{ kind.value }}" {{ query.kind == kind ? 'selected' }}>{{ (kind.value == 'video' ? 'Videos only' : 'Images only')|trans({}, 'theliacms') }}</option>
                    {% endfor %}
                </select>
            </div>
            {# Always there: a library with no tag yet says how to give one,
               instead of hiding the means to narrow a list. #}
            <div class="col-6 col-md-auto">
                <label class="form-label small mb-1" for="cms-media-tag">{{ 'Tag'|trans({}, 'theliacms') }}</label>
                <select class="form-select" id="cms-media-tag" name="tag" data-testid="cms-media-tag"
                        {% if tags is empty %}disabled aria-describedby="cms-media-tag-hint"{% endif %}>
                    <option value="">{{ 'Every tag'|trans({}, 'theliacms') }}</option>
                    {% for title, count in tags %}
                        <option value="{{ title }}" {{ query.tag == title ? 'selected' }}>{{ title }} ({{ count }})</option>
                    {% endfor %}
                </select>
                {% if tags is empty %}
                    <div class="form-text" id="cms-media-tag-hint" data-testid="cms-media-tag-hint">{{ 'No tag yet. Add one from a media sheet or with “Add a tag” below.'|trans({}, 'theliacms') }}</div>
                {% endif %}
            </div>
            <div class="col-6 col-md-auto">
                <label class="form-label small mb-1" for="cms-media-order">{{ 'Order'|trans({}, 'theliacms') }}</label>
                <select class="form-select" id="cms-media-order" name="order">
                    {% for order in orders %}
                        <option value="{{ order.value }}" {{ query.order == order ? 'selected' }}>{{ order_labels[order.value] }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-auto d-flex gap-2">
                <button class="btn btn-outline-secondary text-nowrap" type="submit">{{ 'Apply'|trans({}, 'theliacms') }}</button>
                {% if query.isNarrowed %}
                    <a class="btn btn-link text-nowrap" href="{{ path('admin.cms.media.list', bare_list) }}">{{ 'Clear'|trans({}, 'theliacms') }}</a>
                {% endif %}
            </div>
            {# Two links, not a setting: the view is part of the address, so a
               list bookmarked or opened again comes back drawn the same way. #}
            <div class="col-12 col-md-auto ms-md-auto">
                <div class="btn-group" role="group" aria-label="{{ 'Display'|trans({}, 'theliacms') }}" data-testid="cms-media-views">
                    {% for view in views %}
                        {% set current = view == query.view %}
                        <a class="btn {{ current ? 'btn-secondary' : 'btn-outline-secondary' }} text-nowrap"
                           href="{{ path('admin.cms.media.list', query.viewParameters(view)|merge({ edit_language_id: edit_language_id })) }}"
                           {{ current ? 'aria-current="true"' }} data-testid="cms-media-view-{{ view.value }}">
                            <i class="bi {{ view.value == 'list' ? 'bi-list-ul' : 'bi-grid-3x3-gap' }} me-1" aria-hidden="true"></i>{{ (view.value == 'list' ? 'List' : 'Grid')|trans({}, 'theliacms') }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </form>

        {# Counts come from the library, not from the rows loaded: the grid is
           paged, so counting it announces the size of a page as the size of
           the library. #}
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <p class="text-body-secondary small mb-0" data-testid="cms-media-count">
            {%- if query.kind.value|default('') != 'video' %}
                {{ '%count% image(s)'|trans({ '%count%': tally.total - tally.videos }, 'theliacms') }}
            {%- endif -%}
            {%- if query.kind.value|default('') != 'image' and (tally.videos > 0 or query.kind is not null) %}
                {{ query.kind is null ? '· ' }}{{ '%count% video(s)'|trans({ '%count%': tally.videos }, 'theliacms') }}
            {%- endif -%}
            {%- if tally.undescribed > 0 %}
                · <a class="link-warning" href="{{ path('admin.cms.media.list', bare_list|merge({ filter: 'to-describe' })) }}">{{ '%count% still to describe'|trans({ '%count%': tally.undescribed }, 'theliacms') }}</a>
            {%- endif -%}
            {%- if query.isNarrowed %}
                · {{ '%count% matching'|trans({ '%count%': grid.total }, 'theliacms') }}
            {%- endif -%}
            {%- if grid.pageCount > 1 %}
                · {{ 'page %page% of %pages%'|trans({ '%page%': grid.page, '%pages%': grid.pageCount }, 'theliacms') }}
            {%- endif -%}
            </p>
            {% if tally.undescribed > 0 %}
                <a class="btn btn-sm btn-warning" data-testid="cms-media-describe-start"
                   href="{{ path('admin.cms.media.describe', query.parameters|merge({ edit_language_id: edit_language_id })) }}">
                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>{{ 'Describe them one by one'|trans({}, 'theliacms') }}
                </a>
            {% endif %}
        </div>
    {% endif %}

    {% if grid.items is empty %}
        <div class="card">
            <div class="card-body text-center py-5">
                {% if query.isNarrowed %}
                    <p class="text-muted mb-3">{{ (query.kind.value|default('') == 'video' ? 'No video matches.' : 'No image matches.')|trans({}, 'theliacms') }}</p>
                    <a class="btn btn-outline-secondary" href="{{ path('admin.cms.media.list', bare_list) }}">{{ 'Show every image'|trans({}, 'theliacms') }}</a>
                {% else %}
                    <p class="text-muted mb-0">{{ 'No image yet. Images added here can be placed in any page, and are described once for every page that uses them.'|trans({}, 'theliacms') }}</p>
                {% endif %}
            </div>
        </div>
    {% else %}
        {# Several images answered at once. The boxes of the cards belong to
           this form by their `form` attribute; without the script, it works
           as it is, the script counts and asks before deleting. #}
        <form method="post" id="cms-media-bulk" data-cms-media-bulk data-testid="cms-media-bulk"
              class="d-flex flex-wrap align-items-center gap-2 mb-3 p-2 border rounded bg-body-tertiary sticky-top"
              action="{{ path('admin.cms.media.bulk', query.addressParameters|merge({ edit_language_id: edit_language_id })) }}">
            <input type="hidden" name="_token" value="{{ assignToken() }}">
            <div class="form-check mb-0 me-2">
                <input class="form-check-input" type="checkbox" id="cms-media-select-all" data-cms-media-select-all hidden>
                <label class="form-check-label small" for="cms-media-select-all" data-cms-media-selected hidden>{{ 'Select the page'|trans({}, 'theliacms') }}</label>
            </div>
            <label class="visually-hidden" for="cms-media-bulk-action">{{ 'With the selected files'|trans({}, 'theliacms') }}</label>
            <select class="form-select form-select-sm w-auto" id="cms-media-bulk-action" name="action">
                <option value="">{{ 'With the selected files…'|trans({}, 'theliacms') }}</option>
                <option value="tag-add">{{ 'Add a tag'|trans({}, 'theliacms') }}</option>
                <option value="tag-remove">{{ 'Remove a tag'|trans({}, 'theliacms') }}</option>
                <option value="decorative">{{ 'Mark decorative'|trans({}, 'theliacms') }}</option>
                <option value="not-decorative">{{ 'Mark not decorative'|trans({}, 'theliacms') }}</option>
                <option value="delete">{{ 'Delete the unused ones'|trans({}, 'theliacms') }}</option>
            </select>
            <label class="visually-hidden" for="cms-media-bulk-tag">{{ 'Tag'|trans({}, 'theliacms') }}</label>
            <input class="form-control form-control-sm w-auto" id="cms-media-bulk-tag" name="tag" list="cms-media-bulk-tags"
                   placeholder="{{ 'Tag'|trans({}, 'theliacms') }}" data-cms-media-bulk-tag>
            <datalist id="cms-media-bulk-tags">
                {% for title in tags|keys %}<option value="{{ title }}"></option>{% endfor %}
            </datalist>
            <button type="submit" class="btn btn-sm btn-primary" data-cms-media-bulk-apply>{{ 'Apply'|trans({}, 'theliacms') }}</button>
        </form>

        <dialog class="border-0 rounded shadow p-0" data-cms-media-bulk-dialog aria-labelledby="cms-media-bulk-title"
                style="width: min(480px, calc(100vw - 32px))">
            <div class="p-4">
                <h2 class="h5" id="cms-media-bulk-title">{{ 'Delete the selected files for good?'|trans({}, 'theliacms') }}</h2>
                <p class="text-body-secondary">{{ 'Their files are removed. An image a page or an item still shows is kept.'|trans({}, 'theliacms') }}</p>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-cms-media-bulk-cancel>{{ 'Cancel'|trans({}, 'theliacms') }}</button>
                    <button type="button" class="btn btn-danger" data-cms-media-bulk-confirm>{{ 'Delete the unused ones'|trans({}, 'theliacms') }}</button>
                </div>
            </div>
        </dialog>

        {% if in_list %}
            {% include '@TheliaCMSModule/backOffice/default-twig/media/_table.html.twig' %}
        {% else %}
        <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-4 row-cols-xl-6 g-3">
            {% for item in grid.items %}
                <div class="col">
                    <div class="card h-100 position-relative" data-testid="cms-media-card-{{ item.id }}">
                        <input class="form-check-input position-absolute top-0 start-0 m-2 shadow-sm" style="z-index: 2"
                               type="checkbox" form="cms-media-bulk" name="images[]" value="{{ item.id }}"
                               data-cms-media-select aria-label="{{ 'Select %title%'|trans({ '%title%': item.title }, 'theliacms') }}">
                        {# An icon told from an image at a glance, on the picture
                           itself; its name stays among the badges below. Outside
                           the ratio box, which stretches every child it holds. #}
                        {% if item.iconTag %}
                            <span class="badge text-bg-dark position-absolute top-0 end-0 m-2 shadow-sm" style="z-index: 2" data-testid="cms-media-icon-badge">
                                {{ 'Icon'|trans({}, 'theliacms') }}
                            </span>
                        {% endif %}
                        {# `scale-down`, not `cover`: a media library has to show
                           the real shape of a file, and never blow a small image
                           up to fill the card. #}
                        <a href="{{ path('admin.cms.media.edit', query.addressParameters|merge({ id: item.id, edit_language_id: edit_language_id })) }}"
                           class="ratio ratio-4x3 bg-body-secondary rounded-top overflow-hidden"
                           {# Size and weight on hover and on the sheet: on a card of a
                              library of hundreds, the name and the state come first. #}
                           title="{{ [item.dimensions, item.weight, item.format ? item.format|upper : null]|filter(v => v)|join(' · ') }}">
                            {# No poster is drawn of a video: the browser shows its
                               first frame from the metadata. No controls here, a
                               click opens the sheet. #}
                            {% if item.video %}
                                <video src="{{ item.url }}" preload="metadata" muted playsinline
                                       style="object-fit: scale-down"></video>
                            {% else %}
                                <img src="{{ item.thumbnailUrl }}" alt="" loading="lazy" decoding="async"
                                     style="object-fit: scale-down">
                            {% endif %}
                        </a>
                        <div class="card-body p-2 small">
                            <a class="d-block text-truncate fw-medium text-decoration-none"
                               href="{{ path('admin.cms.media.edit', query.addressParameters|merge({ id: item.id, edit_language_id: edit_language_id })) }}"
                               title="{{ item.title }}">{{ item.title }}</a>


                            {% if item.video %}
                                <span class="badge text-bg-light"><i class="bi bi-camera-video me-1" aria-hidden="true"></i>{{ 'Video'|trans({}, 'theliacms') }}</span>
                                {% if item.conversion.value == 'processing' %}
                                    <span class="badge text-bg-info" data-testid="cms-media-video-state" data-state="processing">{{ 'Processing'|trans({}, 'theliacms') }}</span>
                                {% elseif item.conversion.value == 'failed' %}
                                    <span class="badge text-bg-danger" data-testid="cms-media-video-state" data-state="failed" title="{{ (item.conversionProblem ?? 'The video could not be converted.')|trans({}, 'theliacms') }}">{{ 'Failed'|trans({}, 'theliacms') }}</span>
                                {% endif %}
                            {% elseif not item.isDescribed %}
                                <span class="badge text-bg-warning">
                                    <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                                    {{ 'No alternative text'|trans({}, 'theliacms') }}
                                </span>
                            {% elseif item.decorative %}
                                <span class="badge text-bg-light">{{ 'Decorative'|trans({}, 'theliacms') }}</span>
                            {% endif %}

                            {% if item.iconTag %}
                                <span class="badge text-bg-light font-monospace" data-testid="cms-media-icon-name" title="{{ 'Icon name'|trans({}, 'theliacms') }}">{{ item.iconTag }}</span>
                            {% endif %}

                            {% for tag in item.tags|slice(0, 2) %}
                                <span class="badge text-bg-light">{{ tag }}</span>
                            {% endfor %}
                            {% if item.tags|length > 2 %}
                                <span class="badge text-bg-light" title="{{ item.tags|slice(2)|join(', ') }}">+{{ item.tags|length - 2 }}</span>
                            {% endif %}
                        </div>
                        <div class="card-footer bg-transparent py-2 text-muted small">
                            {% if item.usageCount > 0 %}
                                {% include '@TheliaCMSModule/backOffice/default-twig/linked-pages/_trigger.html.twig' with { kind: 'media', key: item.id, count: item.usageCount, text: 'Used by %count% page(s) or item(s)'|trans({ '%count%': item.usageCount }, 'theliacms'), subject: item.title, testid: 'cms-media-usage-open-' ~ item.id } only %}
                            {% else %}
                                {{ 'Not used yet'|trans({}, 'theliacms') }}
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        {% endif %}

        {% if grid.pageCount > 1 %}
            {% set from = max(1, grid.page - 2) %}
            {% set to = min(grid.pageCount, grid.page + 2) %}
            {% set link = query.parameters|merge({ edit_language_id: edit_language_id }) %}
            <nav class="mt-4" aria-label="{{ 'Pages of the media'|trans({}, 'theliacms') }}" data-testid="cms-media-pages">
                <ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item {{ grid.page == 1 ? 'disabled' }}">
                        <a class="page-link" href="{{ path('admin.cms.media.list', link|merge({ page: grid.page - 1 })) }}">{{ 'Previous'|trans({}, 'theliacms') }}</a>
                    </li>
                    {% if from > 1 %}
                        <li class="page-item"><a class="page-link" href="{{ path('admin.cms.media.list', link|merge({ page: 1 })) }}">1</a></li>
                        {% if from > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                    {% endif %}
                    {% for number in from..to %}
                        <li class="page-item {{ number == grid.page ? 'active' }}" {{ number == grid.page ? 'aria-current="page"' }}>
                            <a class="page-link" href="{{ path('admin.cms.media.list', link|merge({ page: number })) }}">{{ number }}</a>
                        </li>
                    {% endfor %}
                    {% if to < grid.pageCount %}
                        {% if to < grid.pageCount - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                        <li class="page-item"><a class="page-link" href="{{ path('admin.cms.media.list', link|merge({ page: grid.pageCount })) }}">{{ grid.pageCount }}</a></li>
                    {% endif %}
                    <li class="page-item {{ grid.page == grid.pageCount ? 'disabled' }}">
                        <a class="page-link" href="{{ path('admin.cms.media.list', link|merge({ page: grid.page + 1 })) }}">{{ 'Next'|trans({}, 'theliacms') }}</a>
                    </li>
                </ul>
            </nav>
        {% endif %}
    {% endif %}
    <script src="{{ cms_asset('assets/media-upload.js') }}?v={{ assets_version }}" defer></script>
    <script src="{{ cms_asset('assets/media-list.js') }}?v={{ assets_version }}" defer></script>
{% endblock %}
