{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Describe the images'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-media-describe{% endblock %}

{% block content %}
    {% form_theme form with bo_form_themes only %}
    {% set here = list_parameters|merge({ edit_language_id: edit_language_id }) %}
    {% set queue = queue_parameters|merge({ edit_language_id: edit_language_id }) %}

    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: block('title') } %}
        {% block actions %}
            <a class="btn btn-sm btn-outline-secondary" data-testid="cms-media-back" href="{{ path('admin.cms.media.list', here) }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to media'|trans({}, 'theliacms') }}
            </a>
        {% endblock %}
    {% endembed %}

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <p class="mb-0 text-body-secondary" data-testid="cms-media-describe-position">
            {{ 'Image %position% of %total% to describe'|trans({ '%position%': position + 1, '%total%': total }, 'theliacms') }}
        </p>
        {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            {# The image as large as the screen allows: what it shows is what
               the editor has to put into words. #}
            <div class="ratio ratio-4x3 bg-body-secondary rounded overflow-hidden">
                <img src="{{ item.url }}" alt="" style="object-fit: scale-down">
            </div>
        </div>

        <div class="col-lg-5">
            <h2 class="h5 mb-1">{{ item.title }}</h2>
            <p class="text-muted small">
                {%- if item.dimensions %}{{ item.dimensions }} px{% endif -%}
                {%- if item.weight %} · {{ item.weight }}{% endif -%}
                {%- if item.format %} · {{ item.format|upper }}{% endif -%}
                {%- for tag in item.tags %} · {{ tag }}{% endfor -%}
            </p>
            <p class="small">
                {% if item.usageCount > 0 %}
                    {{ 'Used in %count% page(s)'|trans({ '%count%': item.usageCount }, 'theliacms') }}
                {% else %}
                    {{ 'Not used yet'|trans({}, 'theliacms') }}
                {% endif %}
                · <a href="{{ path('admin.cms.media.edit', here|merge({ id: item.id })) }}">{{ 'Open its sheet'|trans({}, 'theliacms') }}</a>
            </p>

            {{ form_start(form, {
                action: path('admin.cms.media.describe', queue|merge({ at: position, image: item.id })),
                attr: { novalidate: 'novalidate', 'data-testid': 'cms-media-describe-form' },
            }) }}
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                {{ form_row(form.alt) }}
                <p class="form-text mt-n2">{{ 'Enter saves and shows the next image.'|trans({}, 'theliacms') }}</p>

                <div class="d-flex flex-wrap gap-2">
                    {# The first button is the one Enter presses. #}
                    <button type="submit" class="btn btn-primary" data-testid="cms-media-describe-save">
                        {{ 'Save and next'|trans({}, 'theliacms') }}
                    </button>
                    {# Decorative is an answer of its own, not a box to tick
                       before saving: the button sends the flag. #}
                    <button type="submit" class="btn btn-outline-secondary" name="{{ field_name(form.decorative) }}" value="1"
                            accesskey="d" data-testid="cms-media-describe-decorative"
                            title="{{ 'Decorative images are published with an empty alternative text so screen readers skip them.'|trans({}, 'theliacms') }}">
                        {{ 'It is decorative'|trans({}, 'theliacms') }}
                    </button>
                    {% if position + 1 < total %}
                        <a class="btn btn-link" data-testid="cms-media-describe-skip"
                           href="{{ path('admin.cms.media.describe', queue|merge({ at: position + 1 })) }}">{{ 'Skip'|trans({}, 'theliacms') }}</a>
                    {% endif %}
                </div>
            {# The flag is sent by its button, not drawn as a box. #}
            {% do form.decorative.setRendered %}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
