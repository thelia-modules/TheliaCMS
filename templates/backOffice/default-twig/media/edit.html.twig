{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ item.title }}{% endblock %}
{% block body_testid %}cms-media-edit{% endblock %}

{% block content %}
    {% form_theme form with bo_form_themes only %}

    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: block('title') } %}
        {% block title %}
            {{ parent() }}
            {% if not item.isDescribed %}
                <span class="badge text-bg-warning">{{ 'No alternative text'|trans({}, 'theliacms') }}</span>
            {% elseif item.decorative %}
                <span class="badge text-bg-light">{{ 'Decorative'|trans({}, 'theliacms') }}</span>
            {% endif %}
        {% endblock %}

        {% block actions %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ item.url }}" target="_blank" rel="noopener">
                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> {{ 'Open the file'|trans({}, 'theliacms') }}
            </a>
            <a class="btn btn-sm btn-outline-secondary" data-testid="cms-media-back" href="{{ path('admin.cms.media.list', list_parameters|merge({ edit_language_id: edit_language_id })) }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to media'|trans({}, 'theliacms') }}
            </a>
        {% endblock %}
    {% endembed %}

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        {# An icon has no description of its own either: see the alternative text below. #}
        {% if item.video or item.iconName is not null %}<span></span>{% else %}
        {# The description is per language and the decorative flag for all of
           them: where the image stands everywhere, without opening it in each
           language. #}
        {% set state_labels = {
            described: 'Described'|trans({}, 'theliacms'),
            missing: 'To describe'|trans({}, 'theliacms'),
            decorative: 'Decorative'|trans({}, 'theliacms'),
        } %}
        <div class="d-flex flex-wrap align-items-center gap-2" data-testid="cms-media-descriptions">
            <span class="small text-body-secondary">{{ 'Description by language'|trans({}, 'theliacms') }}</span>
            {% for description in descriptions %}
                <a class="badge text-decoration-none {{ description.state == 'described' ? 'text-bg-success' : (description.state == 'missing' ? 'text-bg-warning' : 'text-bg-light') }} {{ description.languageId == edit_language_id ? 'border border-2 border-dark' }}"
                   href="{{ path('admin.cms.media.edit', list_parameters|merge({ id: item.id, edit_language_id: description.languageId })) }}"
                   data-locale="{{ description.locale }}" data-state="{{ description.state }}"
                   {{ description.languageId == edit_language_id ? 'aria-current="true"' }}>
                    {{ description.code }} · {{ state_labels[description.state] }}
                </a>
            {% endfor %}
        </div>
        {% endif %}
        {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
    </div>

    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card">
                <div class="ratio ratio-4x3 bg-body-secondary rounded-top overflow-hidden">
                    {% if item.video %}
                        <video src="{{ item.url }}" controls preload="metadata" playsinline style="object-fit: scale-down"></video>
                    {% else %}
                        <img src="{{ item.thumbnailUrl }}" alt="" style="object-fit: scale-down">
                    {% endif %}
                </div>
                <ul class="list-group list-group-flush small">
                    {% if item.video and item.conversion.value != 'ready' %}
                        <li class="list-group-item" data-testid="cms-media-video-state" data-state="{{ item.conversion.value }}">
                            {% if item.conversion.value == 'processing' %}
                                <span class="badge text-bg-info">{{ 'Processing'|trans({}, 'theliacms') }}</span>
                                {{ 'The video is being converted for the web. It cannot be used in a page until it is ready; the file shown here is the one that was sent.'|trans({}, 'theliacms') }}
                            {% else %}
                                <span class="badge text-bg-danger">{{ 'Failed'|trans({}, 'theliacms') }}</span>
                                {{ (item.conversionProblem ?? 'The video could not be converted.')|trans({}, 'theliacms') }}
                            {% endif %}
                        </li>
                    {% endif %}
                    {% if item.dimensions %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">{{ 'Dimensions'|trans({}, 'theliacms') }}</span>
                            <span>{{ item.dimensions }} px</span>
                        </li>
                    {% endif %}
                    {% if item.weight %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">{{ 'Weight'|trans({}, 'theliacms') }}</span>
                            <span>{{ item.weight }}</span>
                        </li>
                    {% endif %}
                    {% if item.format %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">{{ 'Format'|trans({}, 'theliacms') }}</span>
                            <span>{{ item.format|upper }}</span>
                        </li>
                    {% endif %}
                    {% if item.iconTag %}
                        <li class="list-group-item d-flex justify-content-between" data-testid="cms-media-icon-name">
                            <span class="text-muted">{{ 'Icon name'|trans({}, 'theliacms') }}</span>
                            <code>{{ item.iconTag }}</code>
                        </li>
                    {% endif %}
                </ul>
            </div>

            {% if icon_citation is not null %}
                <div class="card mt-3" data-testid="cms-media-icon">
                    <div class="card-header">{{ 'Icon'|trans({}, 'theliacms') }} <code>{{ item.iconTag }}</code></div>
                    <div class="card-body d-flex flex-column gap-3">
                        {% include '@TheliaCMSModule/backOffice/default-twig/media/_icon_citations.html.twig' with { citation: icon_citation, always: true } only %}

                        <form method="post" class="d-flex flex-column gap-2" data-testid="cms-icon-rename"
                              action="{{ path('admin.cms.media.icon_rename', list_parameters|merge({ id: item.id, edit_language_id: edit_language_id })) }}">
                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                            <label for="cms-icon-rename-name" class="form-label small mb-0">{{ 'Icon name'|trans({}, 'theliacms') }}</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text font-monospace">cms:</span>
                                <input type="text" class="form-control font-monospace" id="cms-icon-rename-name" name="icon_name" value="{{ item.iconName }}" maxlength="64" autocomplete="off" spellcheck="false" data-testid="cms-icon-rename-name" {{ icon_citation.isCited ? 'disabled' : '' }}>
                                <button type="submit" class="btn btn-outline-secondary" data-testid="cms-icon-rename-submit" {{ icon_citation.isCited ? 'disabled' : '' }}>{{ 'Rename the icon'|trans({}, 'theliacms') }}</button>
                            </div>
                        </form>

                        <form method="post" data-testid="cms-icon-remove"
                              action="{{ path('admin.cms.media.icon_remove', list_parameters|merge({ id: item.id, edit_language_id: edit_language_id })) }}">
                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                            <button type="submit" class="btn btn-sm btn-outline-secondary" data-testid="cms-icon-remove-submit" {{ icon_citation.isCited ? 'disabled' : '' }}>{{ 'Remove the icon name'|trans({}, 'theliacms') }}</button>
                        </form>

                        {% if icon_citation.isCited %}
                            <p class="small text-body-secondary mb-0" data-testid="cms-icon-locked">{{ 'While a page, an item or a component of the site cites the icon, it keeps its name: they would keep the old one, and the icon would disappear from them.'|trans({}, 'theliacms') }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            <div class="card mt-3">
                {% set used_by = usages|length + item_usages|length + (icon_citation is null ? 0 : icon_citation.components) %}
                <div class="card-header">
                    {% if used_by == 0 %}
                        {{ 'Not used yet'|trans({}, 'theliacms') }}
                    {% else %}
                        {{ 'Used by %count% page(s) or item(s)'|trans({ '%count%': used_by }, 'theliacms') }}
                    {% endif %}
                </div>
                {% if used_by == 0 %}
                    <div class="card-body text-muted small">
                        {{ 'Deleting it now affects nothing.'|trans({}, 'theliacms') }}
                    </div>
                {% else %}
                    <ul class="list-group list-group-flush">
                        {% for usage in usages %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a href="{{ path('admin.cms.pages.edit', { id: usage.page.id, edit_language_id: edit_language_id }) }}">
                                    {{ usage.page.setLocale(edit_locale).title|default('#' ~ usage.page.id) }}
                                </a>
                                <span class="text-muted small">{{ usage.locales|join(', ') }}</span>
                            </li>
                        {% endfor %}
                        {% for usage in item_usages %}
                            <li class="list-group-item d-flex justify-content-between align-items-center" data-testid="cms-media-item-usage">
                                <a href="{{ path('admin.cms.catalogue.content.edit', { type: usage.type, id: usage.id, edit_language_id: edit_language_id }) }}">
                                    {{ usage.title|default('#' ~ usage.id) }}
                                    <span class="text-muted small">({{ usage.type|trans({}, 'theliacms') }})</span>
                                </a>
                                <span class="text-muted small">{{ usage.locales|join(', ') }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>

        <div class="col-lg-7">
            {# `novalidate`: the alternative text is required *unless* the image
               is decorative, and the browser cannot know that. #}
            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                {# A video has neither alternative text nor decorative flag, and the
                   text of an icon belongs to where it is placed. #}
                {% if item.iconName is not null %}
                    {# The label of the field it stands for, so that the note reads in place. #}
                    <div class="form-label mb-1" id="cms-media-icon-alt-label">
                        <span class="bo-form-label__text">{{ 'Alternative text'|trans({}, 'theliacms') }}</span>
                        <small class="bo-form-label__help text-body-secondary">{{ 'What the image shows, for people who cannot see it. Translated per language.'|trans({}, 'theliacms') }}</small>
                    </div>
                    <div class="alert alert-info d-flex gap-2 py-2 small mb-3" role="note" aria-labelledby="cms-media-icon-alt-label" data-testid="cms-media-icon-alt">
                        <i class="bi bi-info-circle flex-shrink-0" aria-hidden="true"></i>
                        <span>{{ 'The alternative text of an icon depends on where it is placed: the component that draws it gives it. Next to a text, an icon is hidden from screen readers; alone in a link or a button, that link or button carries the name.'|trans({}, 'theliacms') }}</span>
                    </div>
                {% elseif not item.video %}
                    {{ form_row(form.alt) }}

                    {# The back-office form theme renders help inside the label, and
                       a checkbox label has none — so this one is written out. #}
                    {{ form_row(form.decorative) }}
                    <p class="form-text mt-n2 mb-3">{{ form.decorative.vars.help|trans({}, 'theliacms') }}</p>
                {% endif %}

                {{ form_row(form.caption) }}
                {{ form_row(form.title) }}
                {# Suggested from the tags the library already has: one tag
                   written twice two ways splits the images it should group. #}
                {{ form_row(form.tags, { attr: { 'data-cms-media-tags': known_tags|json_encode, 'data-remove-label': 'Remove the tag'|trans({}, 'theliacms') } }) }}
                {{ form_row(form.file, { attr: { 'data-cms-media-replace': '' } }) }}
                <div class="mb-3 d-none" data-cms-media-replace-preview>
                    <p class="small text-body-secondary mb-1">{{ 'The new file, in place of the current one once saved:'|trans({}, 'theliacms') }}</p>
                    <img class="img-thumbnail" alt="" style="max-height: 200px">
                    <video class="img-thumbnail d-none" muted playsinline preload="metadata" style="max-height: 200px"></video>
                    <p class="small text-body-secondary mt-1 mb-0" data-cms-media-replace-size></p>
                </div>

                <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'theliacms') }}</button>
            {{ form_end(form) }}

            {# Asked in a dialog of the screen by its script, not by the
               browser's confirm(). #}
            <form method="post" class="mt-3 pt-3 border-top" data-cms-media-delete
                  action="{{ path('admin.cms.media.delete', list_parameters|merge({ id: item.id, edit_language_id: edit_language_id })) }}">
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                <button type="submit" class="btn btn-sm btn-outline-danger" {{ used_by > 0 ? 'disabled' : '' }}>
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>{{ (item.video ? 'Delete this video' : 'Delete this image')|trans({}, 'theliacms') }}
                </button>
                {% if used_by > 0 %}
                    <span class="form-text d-block">{{ 'Remove it from the pages and items above before deleting it.'|trans({}, 'theliacms') }}</span>
                {% endif %}
            </form>

            <dialog class="border-0 rounded shadow p-0" data-cms-media-delete-dialog aria-labelledby="cms-media-delete-title"
                    style="width: min(480px, calc(100vw - 32px))">
                <div class="p-4">
                    <h2 class="h5" id="cms-media-delete-title">{{ (item.video ? 'Delete this video for good?' : 'Delete this image for good?')|trans({}, 'theliacms') }}</h2>
                    <p class="text-body-secondary">{{ 'Its file is removed. No page uses it, so none changes.'|trans({}, 'theliacms') }}</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" data-cms-media-delete-cancel>{{ 'Cancel'|trans({}, 'theliacms') }}</button>
                        <button type="button" class="btn btn-danger" data-cms-media-delete-confirm>{{ (item.video ? 'Delete this video' : 'Delete this image')|trans({}, 'theliacms') }}</button>
                    </div>
                </div>
            </dialog>
        </div>
    </div>

    <script src="{{ cms_asset('assets/media-sheet.js') }}?v={{ assets_version }}" defer></script>
{% endblock %}
