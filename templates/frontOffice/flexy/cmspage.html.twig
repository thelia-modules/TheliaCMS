{#
    A CMS page under the Flexy theme, shipped by the module for the theme: what
    a page gets when Flexy has no `cmspage-{type}.html.twig` of its own. It is
    laid out like a content of the shop (`content.html.twig`): the heading band
    of the theme with the title, the summary and the breadcrumb, then the
    fields of the page type, then the sections of the page.

    The title of the page is its level 1 heading, drawn here: the sections of a
    page start at level 2 (docs/adr/0010). A theme taking the page over with its
    own `cmspage.html.twig` or `cmspage-{type}.html.twig` keeps that promise,
    and emits the same `cmspage.*` hooks.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ cms_page.metaTitle|default(cms_page.title) }}{% endblock %}
{% block meta_description %}{{ cms_page.metaDescription|default('') }}{% endblock %}

{% block robots %}
    {% if cms_page.noindex or cms_page.nofollow %}
        <meta name="robots" content="{{ cms_page.noindex ? 'noindex' : 'index' }}, {{ cms_page.nofollow ? 'nofollow' : 'follow' }}">
    {% endif %}
{% endblock %}

{% block og_image %}{{ cms_page.image ? cms_page.image.url : parent() }}{% endblock %}
{% block og_type %}article{% endblock %}

{% block body_class %}cms-page cms-page--{{ cms_page.pageType }}{% endblock %}

{% block body %}
    {{ theme_hook('cmspage.top', {page: cms_page}) }}

    <twig:Layouts:Subheader:Item
        title="{{ cms_page.title }}"
        description="{{ cms_page.chapo }}"
        :breadcrumb="breadcrumb|default([])"
    />

    {% set fields = cms_page_fields(cms_page) %}

    <div class="pt-6 lg:pt-14 pb-20 lg:pb-30">
        {% if fields is not empty %}
            {# Styled by the stylesheet of the blocks of the module: the theme
               compiles only the utilities of its own files. #}
            <dl class="cms-page__fields">
                {% for field in fields %}
                    <div class="cms-page__field cms-page__field--{{ field.code }}">
                        <dt>{{ field.label }}</dt>
                        <dd>{{ field.text }}</dd>
                    </div>
                {% endfor %}
            </dl>
        {% endif %}

        {# `cms-page-content` is the class the global styles of the site are
           scoped to; the rendered document carries it on its own wrapper too. #}
        {# The mark of a generated page (AI Act, article 50(2)) is stored with the
           page, not in its HTML: the sanitizer would remove it. #}
        <article class="cms-page__content cms-page-content" {{ ai_provenance_attributes(cms_page.provenance) }}>
            {{ theme_hook('cmspage.content.before', {page: cms_page}) }}
            {{ cms_page.html|raw }}
            {{ cms_page_documents_block(cms_page) }}
            {{ theme_hook('cmspage.content.after', {page: cms_page}) }}
        </article>
        {% set ai_label = ai_provenance_label(cms_page.provenance, cms_page.locale) %}
        {% if ai_label %}
            <p class="cms-page__ai-label">{{ ai_label }}</p>
        {% endif %}
    </div>

    {{ theme_hook('cmspage.bottom', {page: cms_page}) }}
{% endblock %}
