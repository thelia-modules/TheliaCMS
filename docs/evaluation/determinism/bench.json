          "draft_document": "{\"version\": 1, \"sections\": [{\"id\": \"titre\", \"component\": \"Layouts:Subheader:Base\", \"props\": {\"title\": \"Nos studios photo à Lyon\", \"tag\": \"h1\", \"container\": \"single-3\", \"centered\": false, \"breadcrumb\": []}}, {\"id\": \"plateaux\", \"component\": \"cms:richtext\", \"props\": {\"html\": \"<h2>Trois plateaux</h2><ul><li><strong>Plateau A</strong> : 120 m², cyclorama de 6 m.</li><li><strong>Plateau B</strong> : 80 m².</li><li><strong>Plateau C</strong> : 40 m², lumière naturelle plein nord.</li></ul>\"}}, {\"id\": \"location\", \"component\": \"cms:richtext\", \"props\": {\"html\": \"<h2>Louer à l’heure ou à la journée</h2><p>La location se fait à l’heure, deux heures minimum, ou à la journée. Les flashs et les fonds sont inclus ; les objectifs sont en option.</p>\"}}, {\"id\": \"acces\", \"component\": \"cms:richtext\", \"props\": {\"html\": \"<h2>Venir en voiture</h2><p>Un parking gratuit de 12 places vous attend devant l’entrée.</p>\"}}]}",
