{
  "id": "compose-text-carousel",
  "family": "composition",
  "locale": "fr_FR",
  "request": "Deux colonnes : du texte à gauche, un carrousel de photos à droite.",
  "oracle": {
    "outcome": [
      "component"
    ],
    "target": [
      "cms:richtext",
      "Site:Carousel"
    ],
    "props": [
      {
        "type": "html",
        "min": 1
      },
      {
        "type": "items",
        "min": 1,
        "with": [
          "image"
        ]
      }
    ],
    "markup": {
      "require": [
        "<img",
        "cms-site--carousel"
      ],
      "forbid": []
    },
    "css": {
      "require": [],
      "forbid": []
    }
  }
}
