<?xml version="1.0" encoding="UTF-8"?>
<database defaultIdMethod="native" name="TheliaMain"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="../../../../vendor/thelia/propel/resources/xsd/database.xsd">

    <!--
        Discriminant columns are VARCHAR + a backed PHP enum, never Propel ENUM:
        Propel maps ENUM to a positional TINYINT, which makes the stored value
        meaningless outside the ORM.
    -->
    <table name="cms_page" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <!--
            Plain integer with 0 as the root, no self-referencing foreign key:
            same shape as `category` and `folder`. A database-level cascade on
            the parent would also defeat the bin, hard-deleting a whole subtree
            behind the soft delete.
        -->
        <column defaultValue="0" name="parent" required="true" type="INTEGER"/>
        <column defaultValue="0" name="position" required="true" type="INTEGER"/>
        <column defaultValue="1" name="visible" required="true" type="TINYINT" size="4"/>
        <column defaultValue="default" name="layout" required="true" size="20" type="VARCHAR"/>
        <column name="publish_at" type="TIMESTAMP"/>
        <column name="unpublish_at" type="TIMESTAMP"/>
        <column name="deleted_at" type="TIMESTAMP"/>
        <!--
            Bookkeeping only, deliberately not foreign keys to `admin`: an
            administrator account is routinely deleted while the pages they
            wrote stay, and the core keeps the same shape for its own
            `log_created_by` columns.
        -->
        <column name="created_by" type="INTEGER"/>
        <column name="updated_by" type="INTEGER"/>

        <column name="title" size="255" type="VARCHAR"/>
        <column name="meta_title" size="255" type="VARCHAR"/>
        <column name="meta_description" type="LONGVARCHAR"/>
        <column name="og_title" size="255" type="VARCHAR"/>
        <column name="og_description" type="LONGVARCHAR"/>
        <!--
            Points at a TheliaLibrary image. No foreign key on purpose: the
            library is a soft dependency whose table may not exist, and a
            cross-module constraint would make this schema unloadable without
            it. A stale id renders as "no image".
        -->
        <column name="og_image_id" type="INTEGER"/>
        <column name="twitter_card" size="20" type="VARCHAR"/>
        <column name="canonical" size="2048" type="VARCHAR"/>
        <column defaultValue="0" name="noindex" required="true" type="TINYINT" size="4"/>
        <column defaultValue="0" name="nofollow" required="true" type="TINYINT" size="4"/>

        <index name="idx_cms_page_parent">
            <index-column name="parent"/>
        </index>
        <index name="idx_cms_page_parent_position">
            <index-column name="parent"/>
            <index-column name="position"/>
        </index>
        <index name="idx_cms_page_deleted_at">
            <index-column name="deleted_at"/>
        </index>

        <behavior name="i18n">
            <parameter name="i18n_columns"
                       value="title, meta_title, meta_description, og_title, og_description, og_image_id, twitter_card, canonical, noindex, nofollow"/>
        </behavior>
        <behavior name="timestampable"/>
    </table>

    <!--
        One GrapesJS project per page and per locale (decision D3): the layout
        itself is translated, not only the strings, so a locale owns its own
        canvas. Draft columns are never read on the front-office path.
    -->
    <table name="cms_page_content" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="page_id" required="true" type="INTEGER"/>
        <column name="locale" required="true" size="5" type="VARCHAR"/>
        <column name="draft_project_data" type="CLOB"/>
        <column name="draft_html" type="CLOB"/>
        <column name="draft_css" type="CLOB"/>
        <column name="published_html" type="CLOB"/>
        <column name="published_css" type="CLOB"/>
        <column name="published_at" type="TIMESTAMP"/>
        <column name="draft_updated_by" type="INTEGER"/>

        <foreign-key foreignTable="cms_page" name="fk_cms_page_content_page" onDelete="CASCADE" onUpdate="RESTRICT">
            <reference foreign="id" local="page_id"/>
        </foreign-key>

        <unique name="unq_cms_page_content_page_locale">
            <unique-column name="page_id"/>
            <unique-column name="locale"/>
        </unique>

        <behavior name="timestampable"/>
    </table>

    <table name="cms_page_revision" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="page_id" required="true" type="INTEGER"/>
        <column name="locale" required="true" size="5" type="VARCHAR"/>
        <column name="project_data" type="CLOB"/>
        <column name="html" type="CLOB"/>
        <column name="css" type="CLOB"/>
        <column name="label" size="60" type="VARCHAR"/>
        <column name="created_by" type="INTEGER"/>

        <foreign-key foreignTable="cms_page" name="fk_cms_page_revision_page" onDelete="CASCADE" onUpdate="RESTRICT">
            <reference foreign="id" local="page_id"/>
        </foreign-key>

        <index name="idx_cms_page_revision_page_locale">
            <index-column name="page_id"/>
            <index-column name="locale"/>
        </index>

        <behavior name="timestampable"/>
    </table>

    <!--
        Search payload extracted at publish time. The FULLTEXT index is added by
        TheliaCMS::install(): TheliaMain.sql is not replayed on activation and
        Propel has no portable FULLTEXT declaration.
    -->
    <table name="cms_page_search" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="page_id" required="true" type="INTEGER"/>
        <column name="locale" required="true" size="5" type="VARCHAR"/>
        <column name="content" type="CLOB"/>

        <foreign-key foreignTable="cms_page" name="fk_cms_page_search_page" onDelete="CASCADE" onUpdate="RESTRICT">
            <reference foreign="id" local="page_id"/>
        </foreign-key>

        <unique name="unq_cms_page_search_page_locale">
            <unique-column name="page_id"/>
            <unique-column name="locale"/>
        </unique>
    </table>

    <!--
        Menus are addressed by code, never by id: a theme calls
        `cms_menu('main')` and must keep working on a site where the menu was
        deleted and created again.
    -->
    <table name="cms_menu" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="code" required="true" size="50" type="VARCHAR"/>

        <column name="title" size="255" type="VARCHAR"/>

        <unique name="unq_cms_menu_code">
            <unique-column name="code"/>
        </unique>

        <behavior name="i18n">
            <parameter name="i18n_columns" value="title"/>
        </behavior>
        <behavior name="timestampable"/>
    </table>

    <!--
        Same tree shape as `cms_page`: plain integer parent with 0 as the root
        and no self-referencing foreign key, so a subtree is moved and deleted
        under application control (depth is capped at three levels there).

        `target_id` points at a CMS page, a content or a folder depending on
        `target_type`; it carries no foreign key because two of those three
        tables belong to the core and the third to this module — a constraint
        would have to be conditional. An item whose target is gone is filtered
        out at render time and flagged in the back office.
    -->
    <table name="cms_menu_item" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="menu_id" required="true" type="INTEGER"/>
        <column defaultValue="0" name="parent" required="true" type="INTEGER"/>
        <column defaultValue="0" name="position" required="true" type="INTEGER"/>
        <column defaultValue="page" name="target_type" required="true" size="20" type="VARCHAR"/>
        <column name="target_id" type="INTEGER"/>
        <column name="url" size="2048" type="VARCHAR"/>
        <column defaultValue="0" name="open_new_tab" required="true" type="TINYINT" size="4"/>

        <!-- Left empty, the label falls back to the title of the target. -->
        <column name="label" size="255" type="VARCHAR"/>

        <foreign-key foreignTable="cms_menu" name="fk_cms_menu_item_menu" onDelete="CASCADE" onUpdate="RESTRICT">
            <reference foreign="id" local="menu_id"/>
        </foreign-key>

        <index name="idx_cms_menu_item_menu_parent_position">
            <index-column name="menu_id"/>
            <index-column name="parent"/>
            <index-column name="position"/>
        </index>
        <index name="idx_cms_menu_item_target">
            <index-column name="target_type"/>
            <index-column name="target_id"/>
        </index>

        <behavior name="i18n">
            <parameter name="i18n_columns" value="label"/>
        </behavior>
        <behavior name="timestampable"/>
    </table>

    <external-schema filename="local/config/schema.xml" referenceOnly="true"/>
</database>
