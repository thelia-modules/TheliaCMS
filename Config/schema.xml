<?xml version="1.0" encoding="UTF-8"?>
<database defaultIdMethod="native" name="TheliaMain"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="../../../../vendor/thelia/propel/resources/xsd/database.xsd">

    <!--
        The tables carry the same storage settings as the core ones, spelled out
        rather than inherited from the server: a table that silently takes the
        default charset of the host cannot be joined with a core table any more
        (error 1267, illegal mix of collations), and it truncates anything the
        default charset does not cover. DYNAMIC raises the index prefix limit to
        3072 bytes, which a four-byte VARCHAR(255) index needs.
    -->
    <vendor type="mysql">
        <parameter name="Engine" value="InnoDB"/>
        <parameter name="Charset" value="utf8mb4"/>
        <parameter name="Collate" value="utf8mb4_general_ci"/>
        <parameter name="RowFormat" value="DYNAMIC"/>
    </vendor>

    <!--
        Discriminant columns are VARCHAR + a backed PHP enum, never Propel ENUM:
        Propel maps ENUM to a positional TINYINT, which makes the stored value
        meaningless outside the ORM.
    -->
    <table name="cms_page" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <!--
            Plain integer with 0 as the root, no self-referencing foreign key:
            same shape as `category` and `folder`. A database-level cascade on
            the parent would also defeat the bin, hard-deleting a whole subtree
            behind the soft delete.
        -->
        <column defaultValue="0" name="parent" required="true" type="INTEGER"/>
        <column defaultValue="0" name="position" required="true" type="INTEGER"/>
        <column defaultValue="1" name="visible" required="true" type="TINYINT" size="4"/>
        <!--
            The code of a row of `cms_page_type`, not its id: a page keeps its
            type through an export and an import into another site. No foreign
            key, for the same reason; a type in use cannot be deleted.
        -->
        <column defaultValue="default" name="page_type" required="true" size="50" type="VARCHAR"/>
        <!--
            The model of its type: the demo content new pages of the type are
            copied from. Never published; at most one per type, which the
            writer keeps.
        -->
        <column defaultValue="0" name="model" required="true" type="TINYINT" size="4"/>
        <!--
            The values of the fields the type defines that are the same in
            every language, as a JSON object by field code; the translated
            ones are in `cms_page_i18n.translated_fields`. Checked against the definition
            of the type on every write (TheliaCMS\Page\Field).
        -->
        <column name="fields" type="CLOB"/>
        <!--
            The image of the page, a TheliaLibrary image, the same in every
            language like the image of a core content. No foreign key, for the
            reason given on `og_image_id`: a stale id renders as "no image".
        -->
        <column name="image_id" type="INTEGER"/>
        <!--
            The one tag of the page, or none. Deleting a tag detaches its
            pages: a tag is a label, nothing a page cannot live without.
        -->
        <column name="tag_id" type="INTEGER"/>
        <column name="publish_at" type="TIMESTAMP"/>
        <column name="unpublish_at" type="TIMESTAMP"/>
        <column name="deleted_at" type="TIMESTAMP"/>
        <!--
            Bookkeeping only, deliberately not foreign keys to `admin`: an
            administrator account is routinely deleted while the pages they
            wrote stay, and the core keeps the same shape for its own
            `log_created_by` columns.
        -->
        <column name="created_by" type="INTEGER"/>
        <column name="updated_by" type="INTEGER"/>

        <column name="title" size="255" type="VARCHAR"/>
        <!--
            The last segment of the address of the page in this language, as an
            author typed it. The address itself lives in the core
            `rewriting_url` table, which the module has to clear when it is
            deactivated: without this copy, the only surviving source is the
            title, and every address anybody had edited would be reinvented on
            the next activation.
        -->
        <column name="slug" size="255" type="VARCHAR"/>
        <!--
            The same pair as the core content and folder: a short summary and a
            longer description, HTML from the back-office editor. Neither is
            the body of the page, which the builder owns: they are what a list
            of pages, a card or a theme shows about it.
        -->
        <column name="chapo" type="LONGVARCHAR"/>
        <column name="description" type="CLOB"/>
        <column name="meta_title" size="255" type="VARCHAR"/>
        <column name="meta_description" type="LONGVARCHAR"/>
        <column name="og_title" size="255" type="VARCHAR"/>
        <column name="og_description" type="LONGVARCHAR"/>
        <!--
            Points at a TheliaLibrary image. No foreign key on purpose: the
            library is a soft dependency whose table may not exist, and a
            cross-module constraint would make this schema unloadable without
            it. A stale id renders as "no image".
        -->
        <column name="og_image_id" type="INTEGER"/>
        <column name="twitter_card" size="20" type="VARCHAR"/>
        <column name="canonical" size="2048" type="VARCHAR"/>
        <column defaultValue="0" name="noindex" required="true" type="TINYINT" size="4"/>
        <column defaultValue="0" name="nofollow" required="true" type="TINYINT" size="4"/>
        <!-- The values of the translated fields, the same JSON as `fields`. -->
        <column name="translated_fields" type="CLOB"/>

        <index name="idx_cms_page_parent">
            <index-column name="parent"/>
        </index>
        <index name="idx_cms_page_parent_position">
            <index-column name="parent"/>
            <index-column name="position"/>
        </index>
        <index name="idx_cms_page_deleted_at">
            <index-column name="deleted_at"/>
        </index>
        <index name="idx_cms_page_tag">
            <index-column name="tag_id"/>
        </index>
        <index name="idx_cms_page_page_type">
            <index-column name="page_type"/>
        </index>

        <foreign-key foreignTable="cms_tag" name="fk_cms_page_tag" onDelete="SET NULL" onUpdate="RESTRICT">
            <reference foreign="id" local="tag_id"/>
        </foreign-key>

        <behavior name="i18n">
            <parameter name="i18n_columns"
                       value="title, slug, chapo, description, meta_title, meta_description, og_title, og_description, og_image_id, twitter_card, canonical, noindex, nofollow, translated_fields"/>
        </behavior>
        <behavior name="timestampable"/>
    </table>

    <!--
        One document per page and per locale: the layout itself is translated,
        not only the strings, so a locale owns its own content. The document
        (JSON, see TheliaCMS\Content\Document) is what is edited; the HTML next
        to it is its rendering, kept so that serving a page reads one column.
        Draft columns are never read on the front-office path.
    -->
    <table name="cms_page_content" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="page_id" required="true" type="INTEGER"/>
        <column name="locale" required="true" size="5" type="VARCHAR"/>
        <column name="draft_document" type="CLOB"/>
        <column name="draft_html" type="CLOB"/>
        <column name="published_document" type="CLOB"/>
        <column name="published_html" type="CLOB"/>
        <column name="published_at" type="TIMESTAMP"/>
        <column name="draft_updated_by" type="INTEGER"/>

        <foreign-key foreignTable="cms_page" name="fk_cms_page_content_page" onDelete="CASCADE" onUpdate="RESTRICT">
            <reference foreign="id" local="page_id"/>
        </foreign-key>

        <unique name="unq_cms_page_content_page_locale">
            <unique-column name="page_id"/>
            <unique-column name="locale"/>
        </unique>

        <behavior name="timestampable"/>
    </table>

    <table name="cms_page_revision" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="page_id" required="true" type="INTEGER"/>
        <column name="locale" required="true" size="5" type="VARCHAR"/>
        <column name="document" type="CLOB"/>
        <column name="html" type="CLOB"/>
        <column name="label" size="60" type="VARCHAR"/>
        <column name="created_by" type="INTEGER"/>

        <foreign-key foreignTable="cms_page" name="fk_cms_page_revision_page" onDelete="CASCADE" onUpdate="RESTRICT">
            <reference foreign="id" local="page_id"/>
        </foreign-key>

        <index name="idx_cms_page_revision_page_locale">
            <index-column name="page_id"/>
            <index-column name="locale"/>
        </index>

        <behavior name="timestampable"/>
    </table>

    <!--
        Search payload extracted at publish time. The FULLTEXT index is added by
        TheliaCMS::install(): TheliaMain.sql is not replayed on activation and
        Propel has no portable FULLTEXT declaration.
    -->
    <table name="cms_page_search" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="page_id" required="true" type="INTEGER"/>
        <column name="locale" required="true" size="5" type="VARCHAR"/>
        <column name="content" type="CLOB"/>

        <foreign-key foreignTable="cms_page" name="fk_cms_page_search_page" onDelete="CASCADE" onUpdate="RESTRICT">
            <reference foreign="id" local="page_id"/>
        </foreign-key>

        <unique name="unq_cms_page_search_page_locale">
            <unique-column name="page_id"/>
            <unique-column name="locale"/>
        </unique>
    </table>

    <!--
        The document of a catalogue item: a product, a category, a content or a
        folder, in one language. The same columns as the content of a page, the
        item named by its type and its id rather than by a foreign key, since
        four tables of the core can own one (docs/adr/0011). The theme prints it
        on the page of the item with cms_item_content().
    -->
    <table name="cms_item_content" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="item_type" required="true" size="16" type="VARCHAR"/>
        <column name="item_id" required="true" type="INTEGER"/>
        <column name="locale" required="true" size="5" type="VARCHAR"/>
        <column name="draft_document" type="CLOB"/>
        <column name="draft_html" type="CLOB"/>
        <column name="published_document" type="CLOB"/>
        <column name="published_html" type="CLOB"/>
        <column name="published_at" type="TIMESTAMP"/>
        <column name="draft_updated_by" type="INTEGER"/>

        <unique name="unq_cms_item_content_item_locale">
            <unique-column name="item_type"/>
            <unique-column name="item_id"/>
            <unique-column name="locale"/>
        </unique>

        <behavior name="timestampable"/>
    </table>

    <table name="cms_item_revision" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="item_type" required="true" size="16" type="VARCHAR"/>
        <column name="item_id" required="true" type="INTEGER"/>
        <column name="locale" required="true" size="5" type="VARCHAR"/>
        <column name="document" type="CLOB"/>
        <column name="html" type="CLOB"/>
        <column name="created_by" type="INTEGER"/>

        <index name="idx_cms_item_revision_item_locale">
            <index-column name="item_type"/>
            <index-column name="item_id"/>
            <index-column name="locale"/>
        </index>

        <behavior name="timestampable"/>
    </table>

    <!--
        Menus are addressed by code, never by id: a theme calls
        `cms_menu('main')` and must keep working on a site where the menu was
        deleted and created again.
    -->
    <table name="cms_menu" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="code" required="true" size="50" type="VARCHAR"/>

        <column name="title" size="255" type="VARCHAR"/>

        <unique name="unq_cms_menu_code">
            <unique-column name="code"/>
        </unique>

        <behavior name="i18n">
            <parameter name="i18n_columns" value="title"/>
        </behavior>
        <behavior name="timestampable"/>
    </table>

    <!--
        Same tree shape as `cms_page`: plain integer parent with 0 as the root
        and no self-referencing foreign key, so a subtree is moved and deleted
        under application control (depth is capped at three levels there).

        `target_id` points at a CMS page, a content or a folder depending on
        `target_type`; it carries no foreign key because two of those three
        tables belong to the core and the third to this module — a constraint
        would have to be conditional. An item whose target is gone is filtered
        out at render time and flagged in the back office.
    -->
    <table name="cms_menu_item" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="menu_id" required="true" type="INTEGER"/>
        <column defaultValue="0" name="parent" required="true" type="INTEGER"/>
        <column defaultValue="0" name="position" required="true" type="INTEGER"/>
        <column defaultValue="page" name="target_type" required="true" size="20" type="VARCHAR"/>
        <column name="target_id" type="INTEGER"/>
        <column name="url" size="2048" type="VARCHAR"/>
        <column defaultValue="0" name="open_new_tab" required="true" type="TINYINT" size="4"/>

        <!-- Left empty, the label falls back to the title of the target. -->
        <column name="label" size="255" type="VARCHAR"/>

        <foreign-key foreignTable="cms_menu" name="fk_cms_menu_item_menu" onDelete="CASCADE" onUpdate="RESTRICT">
            <reference foreign="id" local="menu_id"/>
        </foreign-key>

        <index name="idx_cms_menu_item_menu_parent_position">
            <index-column name="menu_id"/>
            <index-column name="parent"/>
            <index-column name="position"/>
        </index>
        <index name="idx_cms_menu_item_target">
            <index-column name="target_type"/>
            <index-column name="target_id"/>
        </index>

        <behavior name="i18n">
            <parameter name="i18n_columns" value="label"/>
        </behavior>
        <behavior name="timestampable"/>
    </table>

    <!--
        Forms are addressed by code like menus, so a page
        keeps pointing at the right form after it has been renamed.

        `recipients` holds the addresses a submission is sent to. It is only
        ever written from the back office: a form that took its recipient from
        the page — or worse from the request — is an open mail relay.
    -->
    <table name="cms_form" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="code" required="true" size="50" type="VARCHAR"/>
        <column defaultValue="1" name="active" required="true" type="TINYINT" size="4"/>
        <column name="recipients" size="1024" type="VARCHAR"/>
        <column defaultValue="1" name="store_submissions" required="true" type="TINYINT" size="4"/>
        <!-- Days a submission is kept. 0 keeps them until someone deletes them. -->
        <column defaultValue="365" name="retention_days" required="true" type="INTEGER"/>
        <column defaultValue="0" name="send_receipt" required="true" type="TINYINT" size="4"/>
        <!--
            The page the legal notice links to. No foreign key: the page may be
            moved to the bin while the form stays, and a missing page renders as
            no link rather than as a broken form.
        -->
        <column name="privacy_policy_page_id" type="INTEGER"/>
        <!-- Whether a successful submission is reported to the measurement layer. -->
        <column defaultValue="1" name="lead_event" required="true" type="TINYINT" size="4"/>
        <column name="deleted_at" type="TIMESTAMP"/>
        <column name="created_by" type="INTEGER"/>
        <column name="updated_by" type="INTEGER"/>

        <column name="title" size="255" type="VARCHAR"/>
        <column name="description" type="LONGVARCHAR"/>
        <column name="submit_label" size="80" type="VARCHAR"/>
        <column name="success_message" type="LONGVARCHAR"/>
        <column name="legal_notice" type="LONGVARCHAR"/>
        <column name="receipt_subject" size="255" type="VARCHAR"/>
        <column name="receipt_body" type="LONGVARCHAR"/>

        <unique name="unq_cms_form_code">
            <unique-column name="code"/>
        </unique>

        <index name="idx_cms_form_deleted_at">
            <index-column name="deleted_at"/>
        </index>

        <behavior name="i18n">
            <parameter name="i18n_columns"
                       value="title, description, submit_label, success_message, legal_notice, receipt_subject, receipt_body"/>
        </behavior>
        <behavior name="timestampable"/>
    </table>

    <!--
        One row per field of a form.

        `options` carries what a field type needs and no text: the number of
        rows of a textarea, the bounds of a date. The choices of a select or a
        radio are i18n instead — they are written by locale like every other
        piece of content, and a submission archives the label the visitor
        actually read.
    -->
    <table name="cms_form_field" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="form_id" required="true" type="INTEGER"/>
        <column defaultValue="0" name="position" required="true" type="INTEGER"/>
        <column defaultValue="text" name="type" required="true" size="20" type="VARCHAR"/>
        <column name="name" required="true" size="50" type="VARCHAR"/>
        <column defaultValue="0" name="required" required="true" type="TINYINT" size="4"/>
        <column name="options" type="CLOB"/>

        <column name="label" size="255" type="VARCHAR"/>
        <column name="placeholder" size="255" type="VARCHAR"/>
        <column name="help" type="LONGVARCHAR"/>
        <column name="choices" type="LONGVARCHAR"/>

        <foreign-key foreignTable="cms_form" name="fk_cms_form_field_form" onDelete="CASCADE" onUpdate="RESTRICT">
            <reference foreign="id" local="form_id"/>
        </foreign-key>

        <unique name="unq_cms_form_field_form_name">
            <unique-column name="form_id"/>
            <unique-column name="name"/>
        </unique>

        <index name="idx_cms_form_field_form_position">
            <index-column name="form_id"/>
            <index-column name="position"/>
        </index>

        <behavior name="i18n">
            <parameter name="i18n_columns" value="label, placeholder, help, choices"/>
        </behavior>
        <behavior name="timestampable"/>
    </table>

    <!--
        What a visitor sent.

        `email` is a column of its own rather than a key of the JSON payload:
        answering a request to see or to erase personal data means finding every
        submission of one person in seconds, and that is an index, not a scan
        through a text column.

        `ip_hash` is an HMAC, never an address: a bare SHA-256 of an IPv4 is
        brute-forced in 2^32 tries.
    -->
    <table name="cms_form_submission" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="form_id" required="true" type="INTEGER"/>
        <column name="locale" required="true" size="5" type="VARCHAR"/>
        <column name="email" size="255" type="VARCHAR"/>
        <column name="data" type="CLOB"/>
        <column name="ip_hash" size="64" type="VARCHAR"/>

        <foreign-key foreignTable="cms_form" name="fk_cms_form_submission_form" onDelete="CASCADE" onUpdate="RESTRICT">
            <reference foreign="id" local="form_id"/>
        </foreign-key>

        <index name="idx_cms_form_submission_form_created">
            <index-column name="form_id"/>
            <index-column name="created_at"/>
        </index>
        <index name="idx_cms_form_submission_email">
            <index-column name="email"/>
        </index>

        <behavior name="timestampable"/>
    </table>

    <!--
        Third-party snippets: the measurement tags, the chat widget, the ad
        pixel. They live here rather than in a page so that they are the same on
        every page, and so that removing one is a click instead of an edit of
        the theme.

        `consent_category` is the Axeptio vendor whose approval the snippet
        waits for. A snippet that carries one is written to the page inert, as
        `type="text/plain"`, and only started once the visitor has agreed: a tag
        loaded first and asked afterwards has already read the browser.

        The column is named `placement`, not `position`: everywhere else in
        Thelia a `position` column is a sort order, and this one is a place in
        the document.
    -->
    <table name="cms_script" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="title" required="true" size="100" type="VARCHAR"/>
        <column defaultValue="head" name="placement" required="true" size="20" type="VARCHAR"/>
        <column name="consent_category" size="50" type="VARCHAR"/>
        <column defaultValue="0" name="active" required="true" type="TINYINT" size="4"/>
        <column name="content" type="CLOB"/>
        <column name="note" size="500" type="VARCHAR"/>
        <column name="created_by" type="INTEGER"/>
        <column name="updated_by" type="INTEGER"/>

        <index name="idx_cms_script_active_placement">
            <index-column name="active"/>
            <index-column name="placement"/>
        </index>

        <behavior name="timestampable"/>
    </table>

    <!--
        The types a page can have, each one a template of pages (see
        docs/adr/0009): the code picks the `cmspage-{code}` template the page
        is rendered with, and identifies the type through an export; a name,
        a brief and the definition of the fields its pages carry come with
        it. Its model is the page of the type with `cms_page.model` set.
        Named CmsPageTypeDefinition in PHP because `CmsPageType` is the form
        of a page.
    -->
    <table name="cms_page_type" namespace="TheliaCMS\Model" phpName="CmsPageTypeDefinition">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="code" required="true" size="50" type="VARCHAR"/>
        <!--
            What every page of the type is about, read by the generator before
            the brief of the page; the shape of TheliaCMS\Generation\Brief.
        -->
        <column name="brief" type="CLOB"/>
        <column name="brief_tone" size="200" type="VARCHAR"/>
        <column name="brief_audience" size="200" type="VARCHAR"/>
        <!--
            The definition of the fields, a JSON list read by
            TheliaCMS\Page\Field\FieldDefinitions. JSON rather than a table:
            a definition is read whole, and travels whole through an export.
        -->
        <column name="fields" type="CLOB"/>
        <column name="title" size="255" type="VARCHAR"/>
        <column name="description" type="LONGVARCHAR"/>

        <unique name="unq_cms_page_type_code">
            <unique-column name="code"/>
        </unique>

        <behavior name="i18n">
            <parameter name="i18n_columns" value="title, description"/>
        </behavior>
        <behavior name="timestampable"/>
    </table>

    <!--
        The tags of the site. A tag is a name shown as it is, in every
        language, and a page carries at most one of them (`cms_page.tag_id`).
        The name is unique under the collation of the column, so two spellings
        of the same word cannot both exist.
    -->
    <table name="cms_tag" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="name" required="true" size="100" type="VARCHAR"/>

        <unique name="unq_cms_tag_name">
            <unique-column name="name"/>
        </unique>

        <behavior name="timestampable"/>
    </table>

    <!--
        The components the site made in the back office, from a prompt: the
        props as data (the JSON form of TheliaCMS\Content\Prop), a sample, a
        sandboxed Twig template and a stylesheet scoped to the component. Only
        a `ready` one joins the catalogue; a `draft` is still being looked at.
        The code is what documents name (`Site:<code>`) and never changes.
    -->
    <table name="cms_component" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="code" required="true" size="40" type="VARCHAR"/>
        <column name="label" required="true" size="120" type="VARCHAR"/>
        <column name="description" required="true" size="500" type="VARCHAR"/>
        <column name="props" type="CLOB"/>
        <column name="sample" type="CLOB"/>
        <column name="template" type="CLOB"/>
        <column name="css" type="CLOB"/>
        <column defaultValue="draft" name="status" required="true" size="20" type="VARCHAR"/>
        <column name="created_by" type="INTEGER"/>
        <column name="updated_by" type="INTEGER"/>

        <unique name="unq_cms_component_code">
            <unique-column name="code"/>
        </unique>

        <behavior name="timestampable"/>
    </table>

    <!--
        The skills the generator reads before writing a page: shipped as
        files by the module and the theme (`skills/<code>/SKILL.md`), sown
        here at the first read and edited here by the site. `shipped_body`
        keeps the text of the file, so the site can put it back.
    -->
    <table name="cms_skill" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="code" required="true" size="50" type="VARCHAR"/>
        <column name="name" required="true" size="120" type="VARCHAR"/>
        <column name="description" size="500" type="VARCHAR"/>
        <column name="body" type="CLOB"/>
        <column name="shipped_body" type="CLOB"/>
        <column defaultValue="module" name="origin" required="true" size="20" type="VARCHAR"/>
        <column defaultValue="0" name="position" required="true" type="INTEGER"/>
        <column defaultValue="1" name="enabled" required="true" type="TINYINT" size="4"/>
        <column defaultValue="0" name="always" required="true" type="TINYINT" size="4"/>
        <column name="updated_by" type="INTEGER"/>

        <unique name="unq_cms_skill_code">
            <unique-column name="code"/>
        </unique>

        <behavior name="timestampable"/>
    </table>

    <!--
        One row per call to the generator: the brief, what came back, what it
        cost. It is the history of a page an editor iterates on, and the
        ledger the site reads its spend from. `target_type` and `target_id`
        carry no foreign key: a generation for a page the site later deleted
        is still a cost.
    -->
    <table name="cms_page_generation" namespace="TheliaCMS\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column defaultValue="page" name="target_type" required="true" size="20" type="VARCHAR"/>
        <column name="target_id" required="true" type="INTEGER"/>
        <column name="locale" required="true" size="5" type="VARCHAR"/>
        <column defaultValue="brief" name="kind" required="true" size="20" type="VARCHAR"/>
        <column name="prompt" type="CLOB"/>
        <column name="brief" type="CLOB"/>
        <column name="model" size="60" type="VARCHAR"/>
        <column name="request_id" size="80" type="VARCHAR"/>
        <column defaultValue="done" name="status" required="true" size="20" type="VARCHAR"/>
        <column name="stop_reason" size="30" type="VARCHAR"/>
        <column name="stop_category" size="60" type="VARCHAR"/>
        <column defaultValue="0" name="input_tokens" required="true" type="INTEGER"/>
        <column defaultValue="0" name="output_tokens" required="true" type="INTEGER"/>
        <column defaultValue="0" name="cache_read_tokens" required="true" type="INTEGER"/>
        <column defaultValue="0" name="cache_write_tokens" required="true" type="INTEGER"/>
        <column defaultValue="0" name="turns" required="true" type="INTEGER"/>
        <column name="cost_usd" scale="6" size="12" type="DECIMAL"/>
        <column defaultValue="0" name="duration_ms" required="true" type="INTEGER"/>
        <column name="error" type="LONGVARCHAR"/>
        <column name="document" type="CLOB"/>
        <column name="web_pages" type="CLOB"/>
        <column name="left_out" type="CLOB"/>
        <column name="created_by" type="INTEGER"/>

        <index name="idx_cms_page_generation_target">
            <index-column name="target_type"/>
            <index-column name="target_id"/>
            <index-column name="locale"/>
        </index>

        <behavior name="timestampable"/>
    </table>

    <external-schema filename="local/config/schema.xml" referenceOnly="true"/>
</database>
